+"""Join sequential CFG evaluations to their completed UniPC step."""
+
+from dataclasses import dataclass
+
+import torch
+
+from cosmos_framework.model.generator.diffusion.samplers.unipc import UniPCStepEvent
+
+
+def is_guidance_enabled(guidance: float, timestep: float, interval: list[float] | None) -> bool:
+    """Match the native sampler's strict, shifted-timestep interval semantics."""
+    if guidance == 1.0:
+        return False
+    if interval is None:
+        return True
+    if len(interval) != 2:
+        raise ValueError("guidance_interval must contain two endpoints")
+    return interval[0] < timestep < interval[1]
+
+
+@dataclass(frozen=True)
+class ModelEvaluationEvent:
+    """Per-sample branch predictions paired with a solver-owned step snapshot."""
+
+    step: UniPCStepEvent
+    conditional_prediction: torch.Tensor
+    unconditional_prediction: torch.Tensor | None
+    cfg_enabled: bool
+    branch_evaluations: int
+
+
+class StepFeedbackRecorder:
+    """Request-local recorder for sequential conditional/unconditional forwards."""
+
+    def __init__(self) -> None:
+        self._timestep: int | None = None
+        self._cfg_enabled = False
+        self._predictions: dict[str, tuple[torch.Tensor, ...]] = {}
+
+    def begin(self, timestep: int, cfg_enabled: bool) -> None:
+        if self._timestep is not None:
+            raise RuntimeError("Previous evaluation has not completed its solver step")
+        self._timestep = timestep
+        self._cfg_enabled = cfg_enabled
+
+    def record(self, branch: str, predictions: list[torch.Tensor]) -> None:
+        if self._timestep is None or branch not in {"conditional", "unconditional"}:
+            raise ValueError("A known branch must belong to an active evaluation")
+        if branch in self._predictions:
+            raise RuntimeError("A branch was evaluated twice in the same step")
+        self._predictions[branch] = tuple(prediction.detach().clone() for prediction in predictions)
+
+    def complete(self, steps: tuple[UniPCStepEvent, ...]) -> tuple[ModelEvaluationEvent, ...]:
+        conditional = self._predictions.get("conditional")
+        unconditional = self._predictions.get("unconditional")
+        if conditional is None or (self._cfg_enabled and unconditional is None):
+            raise RuntimeError("Missing conditional or required unconditional prediction")
+        if (
+            not steps
+            or len(conditional) != len(steps)
+            or (unconditional is not None and len(unconditional) != len(steps))
+        ):
+            raise ValueError("Prediction batch does not match the solver events")
+        events = []
+        for index, step in enumerate(steps):
+            if step.sample_index != index or step.model_timestep != self._timestep:
+                raise ValueError("Solver event belongs to a different sample or evaluation")
+            if conditional[index].shape != step.guided_prediction.shape:
+                raise ValueError("Prediction layout does not match the solver event")
+            if unconditional is not None and unconditional[index].shape != conditional[index].shape:
+                raise ValueError("Conditional and unconditional layouts differ")
+            events.append(
+                ModelEvaluationEvent(
+                    step=step,
+                    conditional_prediction=conditional[index],
+                    unconditional_prediction=unconditional[index] if unconditional is not None else None,
+                    cfg_enabled=self._cfg_enabled,
+                    branch_evaluations=len(self._predictions),
+                )
+            )
+        self._timestep = None
+        self._predictions = {}
+        return tuple(events)
