diff --git a/cosmos_framework/model/generator/planning_diagnostics.py b/cosmos_framework/model/generator/planning_diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..19f9ccf3cef5bfc41d2f3c4f77f3115890b596fc
--- /dev/null
+++ b/cosmos_framework/model/generator/planning_diagnostics.py
@@ -0,0 +1,312 @@
+"""Evaluation-only paired interventions; no training or checkpoint mutation."""
+
+import hashlib
+import random
+from contextlib import contextmanager
+from dataclasses import replace
+
+import torch
+
+from cosmos_framework.model.generator.algorithm.loss.flow_matching import compute_flow_matching_loss
+
+INTERVENTIONS = ("correct", "reverse_time", "zero_candidate", "disabled")
+
+
+def select_episode_windows(dataset, *, episodes: int = 5, windows: int = 2, seed: int = 42) -> list[dict]:
+    """Select evenly spaced windows within sampled episodes, not adjacent batches."""
+    if episodes < 1 or windows < 1:
+        raise ValueError("Episode and window counts must be positive")
+    records = []
+    offset = 0
+    for source, start, length, episode in dataset._episode_records:
+        if length > 0:
+            records.append((source, episode, start, length, offset))
+        offset += length
+    keys = sorted({(source, episode) for source, episode, *_ in records})
+    selected = set(random.Random(seed).sample(keys, min(episodes, len(keys))))
+    result = []
+    for source, episode, start, length, offset in sorted(records):
+        if (source, episode) not in selected:
+            continue
+        positions = sorted({round(index * (length - 1) / max(1, windows - 1)) for index in range(windows)})
+        for position in positions:
+            result.append(
+                dict(
+                    source_index=source,
+                    episode_id=episode,
+                    dataset_index=offset + position,
+                    global_frame_index=start + position,
+                )
+            )
+    return result
+
+
+@contextmanager
+def paired_denoiser_probe(model, intervention: str, *, replacement: torch.Tensor | None = None):
+    """Change only the post-feedback candidate, or disable all planning writes.
+
+    These are interventions on one trained checkpoint, NOT separately trained
+    B3/B4/control methods. Reverse-time preserves values/norm, but remains OOD.
+    Captured CPU tensors permit exact comparison of source/target pairing.
+    """
+    if intervention not in (*INTERVENTIONS, "same_task", "mismatched", "repeat_correct"):
+        raise ValueError(f"Unknown intervention: {intervention}")
+    if intervention in {"same_task", "mismatched"} and replacement is None:
+        raise ValueError("Candidate replacement requires an explicit donor")
+    original = model.denoise
+    had_override = "denoise" in model.__dict__
+    previous_override = model.__dict__.get("denoise")
+    captured = {}
+    handles = []
+    planner = getattr(getattr(model, "net", None), "action_planner", None)
+    if planner is not None:
+
+        def capture_encoding(module, inputs, output):
+            captured["feedback_encoding"] = output.detach().float().cpu().clone()
+
+        def capture_slots(module, inputs, output):
+            if inputs[0].after_feedback:
+                captured["planning_slots"] = output.slots.detach().float().cpu().clone()
+
+        handles.append(planner.feedback_encoder.register_forward_hook(capture_encoding))
+        handles.append(planner.register_forward_hook(capture_slots))
+
+    def denoise(*args, **kwargs):
+        if torch.is_grad_enabled():
+            raise RuntimeError("Planning probes must run under no_grad for evaluation only")
+        request = kwargs.get("planning_request")
+        if request is not None:
+            packed = kwargs["data_batch_packed"]
+            branch = "bridge" if request.after_feedback else "anchor"
+            captured[f"{branch}_fingerprint"] = packed_fingerprint(packed)
+        if request is not None and request.after_feedback:
+            if request.candidate is None:
+                raise ValueError("Feedback probe requires a candidate")
+            candidate = request.candidate
+            captured["candidate"] = candidate.detach().float().cpu().clone()
+            captured["current_state"] = request.current_state.detach().float().cpu().clone()
+            captured["source_sigma"] = request.source_sigma.detach().float().cpu().clone()
+            packed = kwargs["data_batch_packed"]
+            captured["bridge_input_action"] = torch.cat(packed.action.tokens).detach().float().cpu().clone()
+            captured["bridge_sigma"] = request.sigma.detach().float().cpu().clone()
+            if intervention == "reverse_time":
+                kwargs["planning_request"] = replace(request, candidate=candidate.flip(1))
+            elif intervention == "zero_candidate":
+                kwargs["planning_request"] = replace(request, candidate=torch.zeros_like(candidate))
+            elif replacement is not None:
+                if replacement.shape != candidate.shape or not torch.isfinite(replacement).all():
+                    raise ValueError("Donor candidate must be finite and match the original shape")
+                kwargs["planning_request"] = replace(request, candidate=replacement.to(candidate))
+            captured["used_candidate"] = kwargs["planning_request"].candidate.detach().float().cpu().clone()
+        if intervention == "disabled":
+            kwargs.pop("planning_request", None)
+            kwargs.pop("planning_state", None)
+        output = original(*args, **kwargs)
+        if request is not None and request.after_feedback:
+            captured["bridge_prediction_action"] = torch.cat(output["preds_action"]).detach().float().cpu().clone()
+        return output
+
+    model.denoise = denoise
+    try:
+        yield captured
+    finally:
+        for handle in handles:
+            handle.remove()
+        if had_override:
+            model.denoise = previous_override
+        else:
+            del model.denoise
+
+
+def tensor_delta(reference: torch.Tensor, changed: torch.Tensor) -> dict[str, float]:
+    delta = changed.float() - reference.float()
+    norm = torch.linalg.vector_norm(delta).item()
+    reference_norm = torch.linalg.vector_norm(reference.float()).item()
+    return dict(
+        l2=norm,
+        rms=delta.square().mean().sqrt().item(),
+        reference_l2=reference_norm,
+        relative_l2=norm / max(reference_norm, 1e-12),
+    )
+
+
+def assert_paired(reference: dict, candidate: dict, *, same_feedback: bool = True) -> None:
+    for key in ("anchor_fingerprint", "bridge_fingerprint"):
+        if key in reference:
+            if reference[key] != candidate[key]:
+                raise ValueError(f"Unpaired {key}")
+    for key in ("bridge_input_action", "bridge_sigma", "source_sigma"):
+        torch.testing.assert_close(reference[key], candidate[key], rtol=0, atol=0, msg=f"Unpaired {key}")
+    if same_feedback:
+        torch.testing.assert_close(reference["candidate"], candidate["candidate"], rtol=0, atol=0)
+
+
+def packed_fingerprint(packed) -> str:
+    digest = hashlib.sha256()
+    tensors = list(packed.action.tokens)
+    if getattr(packed, "vision", None) is not None:
+        tensors.extend(packed.vision.tokens)
+    if getattr(packed, "text_indexes", None) is not None:
+        tensors.append(packed.text_indexes)
+    for tensor in tensors:
+        value = tensor.detach().float().cpu().contiguous()
+        digest.update(str(tuple(value.shape)).encode())
+        digest.update(value.numpy().tobytes())
+    return digest.hexdigest()
+
+
+@contextmanager
+def paired_loss_probe(model):
+    original = model._compute_losses
+    had_override = "_compute_losses" in model.__dict__
+    previous_override = model.__dict__.get("_compute_losses")
+    branches = []
+
+    def compute(output, packed, noised, timesteps, is_image, **kwargs):
+        loss, metrics = original(output, packed, noised, timesteps, is_image, **kwargs)
+        config = model.config.rectified_flow_training_config
+        parts = dict(
+            action=metrics["flow_matching_loss_action"] * config.action_loss_weight,
+            vision=metrics["flow_matching_loss_vision"] * config.loss_scale,
+        )
+        for group, channels in (("joints", slice(0, 7)), ("gripper", slice(7, 8))):
+            value, _ = compute_flow_matching_loss(
+                pred=[item[:, channels] for item in output["preds_action"]],
+                target=[item[:, channels] for item in noised.vt_target_action],
+                condition_mask=packed.action.condition_mask,
+                timesteps=timesteps,
+                has_valid_tokens=True,
+                rectified_flow=model.rectified_flow_action,
+                tensor_kwargs_fp32=model.tensor_kwargs_fp32,
+                action_valid_mask=None
+                if packed.action.action_valid_mask is None
+                else [None if item is None else item[channels] for item in packed.action.action_valid_mask],
+                normalize_by_active=config.normalize_loss_by_active,
+            )
+            parts[group] = value
+        torch.testing.assert_close(
+            (7 * parts["joints"] + parts["gripper"]) / 8, metrics["flow_matching_loss_action"], rtol=1e-5, atol=1e-7
+        )
+        branches.append(parts)
+        return loss, metrics
+
+    model._compute_losses = compute
+    try:
+        yield branches
+    finally:
+        if had_override:
+            model._compute_losses = previous_override
+        else:
+            del model._compute_losses
+
+
+def episode_bootstrap(differences: dict, *, seed: int = 42, draws: int = 2000) -> dict:
+    import numpy as np
+
+    values = np.array([sum(group) / len(group) for _, group in sorted(differences.items())])
+    if not len(values):
+        raise ValueError("No paired episodes")
+    samples = np.random.default_rng(seed).choice(values, size=(draws, len(values)), replace=True).mean(axis=1)
+    return dict(
+        mean=float(values.mean()),
+        ci95=np.quantile(samples, [0.025, 0.975]).tolist(),
+        improved=int((values < 0).sum()),
+        degraded=int((values > 0).sum()),
+        tied=int((values == 0).sum()),
+        episodes=len(values),
+        unit="episode",
+        bootstrap_seed=seed,
+        draws=draws,
+    )
+
+
+def compare_reports(reports: list[dict], *, include_interventions: bool = True) -> dict:
+    if len(reports) < 2 or any(report["status"] != "completed" for report in reports):
+        raise ValueError("Need at least two completed reports")
+    reference = reports[0]
+    for report in reports[1:]:
+        for key in (
+            "manifest",
+            "sample_preparation_seed",
+            "validation_noise_seed",
+            "loss_weights",
+            "checkpoint_selection",
+        ):
+            if report[key] != reference[key]:
+                raise ValueError(f"Mismatched evaluation contract: {key}")
+    metrics = ("action", "joints", "gripper", "weighted_action", "weighted_vision", "objective")
+
+    def indexed(report):
+        result = {}
+        for row in report["rows"]:
+            if row["intervention"] != "correct":
+                continue
+            key = (row["weights"], row["split"], row["source_index"], row["episode_id"], row["dataset_index"])
+            if key in result:
+                raise ValueError("Duplicate comparison window")
+            result[key] = dict(
+                row, action=(row["anchor_flow_matching_loss_action"] + row["bridge_flow_matching_loss_action"]) / 2
+            )
+        return result
+
+    indexed_reports = [(report["method"], indexed(report)) for report in reports]
+    comparisons = []
+    for left_index, (left_name, left) in enumerate(indexed_reports):
+        for right_name, right in indexed_reports[left_index + 1 :]:
+            if left.keys() != right.keys():
+                raise ValueError("Comparison windows or weight families differ")
+            for family, split in sorted({key[:2] for key in left}):
+                selected = [key for key in left if key[:2] == (family, split)]
+                for key in selected:
+                    for field in ("anchor_fingerprint", "bridge_fingerprint", "bridge_sigma", "source_sigma"):
+                        if left[key][field] != right[key][field]:
+                            raise ValueError(f"Unpaired {field}: {key}")
+                stats = {}
+                for metric in metrics:
+                    differences, left_values, right_values = {}, {}, {}
+                    for key in selected:
+                        episode = key[2:4]
+                        differences.setdefault(episode, []).append(right[key][metric] - left[key][metric])
+                        left_values.setdefault(episode, []).append(left[key][metric])
+                        right_values.setdefault(episode, []).append(right[key][metric])
+                    stats[metric] = dict(
+                        episode_bootstrap(differences),
+                        reference_mean=sum(sum(values) / len(values) for values in left_values.values())
+                        / len(left_values),
+                        compared_mean=sum(sum(values) / len(values) for values in right_values.values())
+                        / len(right_values),
+                        per_episode=[
+                            dict(source=key[0], episode=key[1], difference=sum(values) / len(values))
+                            for key, values in sorted(differences.items())
+                        ],
+                    )
+                comparisons.append(
+                    dict(
+                        reference=left_name,
+                        compared=right_name,
+                        weights=family,
+                        split=split,
+                        difference="compared minus reference; negative is improvement",
+                        metrics=stats,
+                    )
+                )
+    interventions = []
+    if include_interventions:
+        for report in reports:
+            for condition in sorted({row["intervention"] for row in report["rows"]} - {"correct"}):
+                variant = dict(
+                    report,
+                    method=f"{report['method']}:{condition}",
+                    rows=[
+                        dict(row, intervention="correct") for row in report["rows"] if row["intervention"] == condition
+                    ],
+                )
+                interventions.extend(compare_reports([report, variant], include_interventions=False)["comparisons"])
+    return dict(
+        status="completed",
+        scope="synthetic paired-FM, fixed checkpoint and one training seed; not rollout",
+        intervals="paired episode percentile bootstrap; not training-seed or site uncertainty",
+        reports=[dict(method=report["method"], checkpoint=report["checkpoint"]) for report in reports],
+        comparisons=comparisons,
+        intervention_comparisons=interventions,
+    )
