new file mode 100644
index 0000000000000000000000000000000000000000..8ae6c6355f5060a5faef9475e73af83cf71cad59
--- /dev/null
+++ b/cosmos_framework/model/generator/action_policy_sft_model.py
@@ -0,0 +1,51 @@
+"""DROID warm-start policy: Generator LoRA plus existing action heads."""
+
+import random
+
+import numpy as np
+import torch
+
+from cosmos_framework.model.generator.omni_mot_model import OmniMoTModel
+
+ACTION_HEAD_MODULES = ("action2llm", "llm2action", "action_modality_embed")
+
+
+class ActionPolicySFTModel(OmniMoTModel):
+    @torch.no_grad()
+    def validation_step(self, data_batch: dict, iteration: int):
+        del iteration
+        devices = [torch.cuda.current_device()] if str(self.tensor_kwargs["device"]).startswith("cuda") else []
+        python_rng, numpy_rng = random.getstate(), np.random.get_state()
+        was_training = self.net.training
+        try:
+            with torch.random.fork_rng(devices=devices):
+                random.seed(1729)
+                np.random.seed(1729)
+                torch.random.default_generator.manual_seed(1729)
+                if devices:
+                    torch.cuda.manual_seed(1729)
+                self.net.eval()
+                return self.training_step(data_batch, 0)
+        finally:
+            self.net.train(was_training)
+            random.setstate(python_rng)
+            np.random.set_state(numpy_rng)
+
+    def add_lora(
+        self,
+        network: torch.nn.Module,
+        lora_rank: int,
+        lora_alpha: int,
+        lora_target_modules: str,
+    ) -> torch.nn.Module:
+        network = super().add_lora(network, lora_rank, lora_alpha, lora_target_modules)
+        found = set()
+        for name, parameter in network.named_parameters():
+            root = name.split(".", 1)[0]
+            if root in ACTION_HEAD_MODULES:
+                parameter.requires_grad_(True)
+                found.add(root)
+        missing = set(ACTION_HEAD_MODULES) - found
+        if missing:
+            raise ValueError(f"Action policy LoRA requires existing action heads: {sorted(missing)}")
+        return network
