+import os
+from datetime import timedelta
+from pathlib import Path
+
+import pytest
+import tomllib
+import torch
+from torch import nn
+
+from cosmos_framework.inference.fixtures.args import MAX_GPUS
+from cosmos_framework.model.generator.action_policy_sft_model import ACTION_HEAD_MODULES, ActionPolicySFTModel
+
+
+def test_policy_lora_unfreezes_only_existing_action_heads_before_fsdp() -> None:
+    with torch.device("meta"):
+        network = nn.Module()
+        network.q_proj_moe_gen = nn.Linear(8, 8)
+        network.q_proj = nn.Linear(8, 8)
+        network.action2llm = nn.Linear(8, 8)
+        network.llm2action = nn.Linear(8, 8)
+        network.action_modality_embed = nn.Embedding(2, 8)
+        network.action_pos_embed = nn.Embedding(32, 8)
+    model = object.__new__(ActionPolicySFTModel)
+    model.add_lora(network, lora_rank=2, lora_alpha=2, lora_target_modules="q_proj_moe_gen")
+    for name, parameter in network.named_parameters():
+        expected = name.split(".", 1)[0] in ACTION_HEAD_MODULES or "lora_" in name
+        assert parameter.requires_grad == expected, name
+    assert network.action_pos_embed.weight.requires_grad is False
+
+
+def test_policy_lora_rejects_missing_action_head() -> None:
+    with torch.device("meta"):
+        network = nn.Module()
+        network.q_proj_moe_gen = nn.Linear(8, 8)
+    model = object.__new__(ActionPolicySFTModel)
+    with pytest.raises(ValueError, match="existing action heads"):
+        model.add_lora(network, 2, 2, "q_proj_moe_gen")
+
+
+def test_edge_recipe_preserves_policy_heads_and_nano_source() -> None:
+    from cosmos_framework.configs.base.experiment.action.posttrain_config.action_policy_droid_edge import (
+        action_policy_droid_edge,
+    )
+    from cosmos_framework.configs.base.experiment.action.posttrain_config.action_policy_droid_nano import (
+        action_policy_droid_nano,
+    )
+    from cosmos_framework.configs.toml_config.sft_config import SFTExperimentConfig
+
+    recipe = action_policy_droid_edge
+    assert recipe.model.config.parallelism.data_parallel_shard_degree == 4
+    assert recipe.model.config.lora_enabled
+    assert recipe.checkpoint.keys_to_skip_loading == ["net_ema.", "lora_"]
+    assert not recipe.checkpoint.load_training_state
+    assert recipe.model.config.tokenizer.encode_exact_durations == [33]
+    assert recipe.optimizer.keys_to_select == ["lora_", *ACTION_HEAD_MODULES]
+    assert "action2llm" in action_policy_droid_nano.checkpoint.keys_to_skip_loading
+    assert action_policy_droid_nano.optimizer.lr == 2e-4
+    path = Path(__file__).resolve().parents[3] / "examples/toml/sft_config/action_policy_droid_edge.toml"
+    parsed = SFTExperimentConfig.model_validate(tomllib.loads(path.read_text()))
+    assert parsed.job.experiment == "action_policy_droid_edge"
+    assert parsed.model.parallelism.data_parallel_shard_degree == 4
+
+
+@pytest.mark.level(1)
+@pytest.mark.gpus(MAX_GPUS)
+def test_four_rank_fsdp_action_policy_parameter_updates() -> None:
+    import torch.distributed as distributed
+    from torch.distributed.device_mesh import init_device_mesh
+    from torch.distributed.fsdp import MixedPrecisionPolicy, fully_shard
+
+    from cosmos_framework.utils.generator.lora import init_lora_weights_post_materialization
+
+    if int(os.environ.get("WORLD_SIZE", "1")) != 4:
+        pytest.skip("Launch this smoke with torchrun --nproc-per-node=4")
+    if os.environ.get("CUDA_VISIBLE_DEVICES") != "0,1,2,3":
+        pytest.skip(
+            f"This smoke is restricted to physical GPUs 0-3; got {os.environ.get('CUDA_VISIBLE_DEVICES')!r}, rank={os.environ.get('RANK')}"
+        )
+    local_rank = int(os.environ["LOCAL_RANK"])
+    torch.cuda.set_device(local_rank)
+    owns_group = not distributed.is_initialized()
+    if owns_group:
+        distributed.init_process_group("nccl", timeout=timedelta(seconds=120))
+    try:
+
+        class TinyPolicy(nn.Module):
+            def __init__(self):
+                super().__init__()
+                self.q_proj_moe_gen = nn.Linear(32, 32)
+                self.q_proj = nn.Linear(32, 32)
+                self.action2llm = nn.Linear(8, 32)
+                self.llm2action = nn.Linear(32, 8)
+                self.action_modality_embed = nn.Parameter(torch.zeros(32))
+
+            def forward(self, action):
+                hidden = self.action2llm(action) + self.action_modality_embed
+                return self.llm2action(torch.nn.functional.silu(self.q_proj_moe_gen(hidden)))
+
+        torch.manual_seed(42)
+        with torch.device("meta"):
+            network = TinyPolicy()
+        model = object.__new__(ActionPolicySFTModel)
+        model.add_lora(network, 2, 2, "q_proj_moe_gen")
+        registered_keys = tuple(network.state_dict())
+        fully_shard(
+            network,
+            mesh=init_device_mesh("cuda", (4,)),
+            mp_policy=MixedPrecisionPolicy(param_dtype=torch.bfloat16, reduce_dtype=torch.float32),
+        )
+        network.to_empty(device=torch.device("cuda", local_rank))
+        for name, parameter in network.named_parameters():
+            if "lora_" not in name:
+                torch.nn.init.normal_(parameter, std=0.02)
+        init_lora_weights_post_materialization(network)
+        assert registered_keys == tuple(network.state_dict())
+        optimizer = torch.optim.AdamW(
+            [parameter for parameter in network.parameters() if parameter.requires_grad], lr=1e-3
+        )
+        before = network.action2llm.weight.to_local().detach().clone()
+        frozen = network.q_proj.weight.to_local().detach().clone()
+        for _ in range(3):
+            optimizer.zero_grad(set_to_none=True)
+            action = torch.randn(4, 8, device="cuda", dtype=torch.bfloat16)
+            loss = network(action).float().square().mean()
+            loss.backward()
+            assert torch.isfinite(loss)
+            assert network.action2llm.weight.grad is not None
+            assert torch.isfinite(network.action2llm.weight.grad.to_local()).all()
+            optimizer.step()
+        assert not torch.equal(network.action2llm.weight.to_local(), before)
+        torch.testing.assert_close(network.q_proj.weight.to_local(), frozen, rtol=0, atol=0)
+        assert network.q_proj.weight.grad is None
+        distributed.barrier()
