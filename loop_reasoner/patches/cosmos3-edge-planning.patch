+from dataclasses import replace
+from types import MethodType, SimpleNamespace
+
+import pytest
+import torch
+
+from cosmos_framework.model.generator.diffusion.samplers.step_feedback import (
+    StepFeedbackRecorder,
+    is_guidance_enabled,
+)
+from cosmos_framework.model.generator.diffusion.samplers.unipc import UniPCSampler
+
+pytestmark = [pytest.mark.level(0), pytest.mark.gpus(0)]
+
+
+@pytest.mark.parametrize(
+    ("timestep", "expected"),
+    [(959, False), (960, False), (961, True), (999, True), (1000, True), (1001, False), (1002, False)],
+)
+def test_guidance_interval_uses_strict_endpoints(timestep: int, expected: bool) -> None:
+    assert is_guidance_enabled(3.0, timestep, [960, 1001]) is expected
+    assert not is_guidance_enabled(1.0, timestep, [960, 1001])
+    assert is_guidance_enabled(3.0, timestep, None)
+
+
+def test_feedback_records_five_branch_evaluations_without_changing_sampling() -> None:
+    sampler = UniPCSampler(tensor_kwargs={"device": torch.device("cpu")})
+    recorder = StepFeedbackRecorder()
+    completed = []
+
+    def velocity_fn(samples: list[torch.Tensor], timestep: torch.Tensor) -> list[torch.Tensor]:
+        cfg_enabled = is_guidance_enabled(3.0, timestep.item(), [960, 1001])
+        recorder.begin(int(timestep.item()), cfg_enabled)
+        conditional = [sample * 0.25 for sample in samples]
+        recorder.record("conditional", conditional)
+        if not cfg_enabled:
+            return conditional
+        unconditional = [sample * 0.5 for sample in samples]
+        recorder.record("unconditional", unconditional)
+        return [uncond + 3 * (cond - uncond) for cond, uncond in zip(conditional, unconditional)]
+
+    def callback(events):
+        completed.append(recorder.complete(events))
+
+    sampler(
+        velocity_fn,
+        [torch.ones(4), torch.full((4,), 2.0)],
+        num_steps=4,
+        shift=5.0,
+        seed=[0, 1],
+        post_step_callback=callback,
+    )
+    assert [batch[0].cfg_enabled for batch in completed] == [True, False, False, False]
+    assert sum(batch[0].branch_evaluations for batch in completed) == 5
+    for batch in completed:
+        for event in batch:
+            expected = event.conditional_prediction
+            if event.cfg_enabled:
+                expected = event.unconditional_prediction + 3 * (expected - event.unconditional_prediction)
+            else:
+                assert event.unconditional_prediction is None
+            torch.testing.assert_close(event.step.guided_prediction, expected)
+
+
+def test_recorder_rejects_missing_and_mismatched_evaluations() -> None:
+    recorder = StepFeedbackRecorder()
+    recorder.begin(999, True)
+    recorder.record("conditional", [torch.ones(4)])
+    with pytest.raises(RuntimeError, match="Missing"):
+        recorder.complete(())
+    with pytest.raises(RuntimeError, match="not completed"):
+        recorder.begin(937, False)
+    with pytest.raises(RuntimeError, match="twice"):
+        recorder.record("conditional", [torch.ones(4)])
+
+    sampler = UniPCSampler(tensor_kwargs={"device": torch.device("cpu")})
+    events = []
+    sampler(
+        lambda sample, timestep: sample * 0.25,
+        torch.ones(4),
+        num_steps=4,
+        shift=5.0,
+        seed=0,
+        post_step_callback=lambda batch: events.extend(batch),
+    )
+    recorder.record("unconditional", [torch.ones(4)])
+    with pytest.raises(ValueError, match="different sample or evaluation"):
+        recorder.complete((replace(events[0], sample_index=1),))
+    with pytest.raises(ValueError, match="different sample or evaluation"):
+        recorder.complete((events[1],))
+    assert recorder.complete((events[0],))[0].branch_evaluations == 2
+
+
+def test_cfg_disabled_can_record_alignment_only_unconditional() -> None:
+    recorder = StepFeedbackRecorder()
+    sampler = UniPCSampler(tensor_kwargs={"device": torch.device("cpu")})
+    completed = []
+
+    def velocity_fn(sample, timestep):
+        recorder.begin(int(timestep.item()), False)
+        recorder.record("conditional", [sample])
+        recorder.record("unconditional", [sample * 2])
+        return sample
+
+    sampler(
+        velocity_fn,
+        torch.ones(4),
+        num_steps=2,
+        seed=0,
+        post_step_callback=lambda events: completed.extend(recorder.complete(events)),
+    )
+    assert all(not event.cfg_enabled and event.branch_evaluations == 2 for event in completed)
+
+
+@pytest.mark.parametrize("planning_enabled", [False, True])
+def test_native_generate_entrypoint_preserves_output_and_branch_count(planning_enabled: bool) -> None:
+    from cosmos_framework.model.generator.mot.recurrent_latent_planner import PlanningState
+    from cosmos_framework.model.generator.omni_mot_model import OmniMoTModel
+
+    branch_calls = []
+    completed = []
+    conditional_tokens = [[10]]
+    unconditional_tokens = [[20]]
+    clean = SimpleNamespace(
+        x0_tokens_vision=[torch.zeros(1, 1, 1, 4)],
+        num_vision_items_per_sample=None,
+        num_lidar_items_per_sample=None,
+    )
+    plans = [SimpleNamespace(has_lidar=False, has_action=False, has_sound=False)]
+    planning_state = PlanningState(torch.ones(1, 3, 8), torch.ones(1, dtype=torch.bool), torch.ones(1))
+    provider_calls = []
+
+    def provider(timestep):
+        provider_calls.append(timestep)
+        return planning_state
+
+    def get_velocity(**kwargs):
+        conditional = kwargs["text_tokens"] is conditional_tokens
+        if "planning_state" in kwargs:
+            assert conditional and kwargs["planning_state"] is planning_state
+        branch_calls.append(conditional)
+        return [sample * (0.25 if conditional else 0.5) for sample in kwargs["noise_x"]]
+
+    model = SimpleNamespace(
+        parallel_dims=None,
+        net=None,
+        config=SimpleNamespace(
+            sound_gen=False, rectified_flow_inference_config=SimpleNamespace(scheduler_type="unipc")
+        ),
+        sampler=UniPCSampler(tensor_kwargs={"device": torch.device("cpu")}),
+        _maybe_apply_prompt_upsampling=lambda batch, **kwargs: batch,
+        _prepare_inference_data=lambda *args: (
+            plans,
+            clean,
+            conditional_tokens,
+            unconditional_tokens,
+            [torch.ones(4)],
+            None,
+            None,
+            False,
+        ),
+        _can_reuse_inference_pack_templates=lambda *args: False,
+        _can_reuse_inference_text_kv=lambda *args, **kwargs: False,
+        _get_velocity=get_velocity,
+    )
+    model._run_classifier_free_guidance = MethodType(OmniMoTModel._run_classifier_free_guidance, model)
+    arguments = dict(seed=[0], num_steps=4, shift=5.0, guidance=3.0, guidance_interval=[960, 1001])
+    if planning_enabled:
+        arguments["planning_state_provider"] = provider
+    expected = OmniMoTModel.generate_samples_from_batch(model, {}, **arguments)
+    assert branch_calls == [True, False, True, True, True]
+    branch_calls.clear()
+    actual = OmniMoTModel.generate_samples_from_batch(model, {}, evaluation_callback=completed.append, **arguments)
+    torch.testing.assert_close(actual["vision"][0], expected["vision"][0], rtol=0, atol=0)
+    assert branch_calls == [True, False, True, True, True]
+    assert len(completed) == 4
+    assert sum(batch[0].branch_evaluations for batch in completed) == 5
+    assert provider_calls == ([999, 937, 833, 624] * 2 if planning_enabled else [])
+    branch_calls.clear()
+    with pytest.raises(ValueError, match="sequential CFG"):
+        OmniMoTModel.generate_samples_from_batch(
+            model,
+            {},
+            evaluation_callback=completed.append,
+            velocity_postprocess_builder=lambda **kwargs: None,
+            **arguments,
+        )
+    assert not branch_calls
