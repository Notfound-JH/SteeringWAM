+def test_real_paired_fm_training_and_deterministic_validation(mode) -> None:
+    model = _tiny_training_model(mode)
+    frozen = {name: value.detach().clone() for name, value in model.net.named_parameters() if not value.requires_grad}
+    optimizer = torch.optim.AdamW(
+        [parameter for parameter in model.net.parameters() if parameter.requires_grad], lr=1e-3
+    )
+    for iteration in range(3):
+        optimizer.zero_grad(set_to_none=True)
+        output, loss = model.training_step({}, iteration)
+        assert torch.isfinite(loss) and output["planning_supervised_forwards"] == 2
+        for modality in ("action", "vision"):
+            anchor = output[f"anchor_flow_matching_loss_{modality}"]
+            bridge = output[f"bridge_flow_matching_loss_{modality}"]
+            assert not anchor.requires_grad and not bridge.requires_grad
+            torch.testing.assert_close((anchor + bridge) / 2, output[f"flow_matching_loss_{modality}"])
+        loss.backward()
+        optimizer.step()
+    assert model.net.action_planner.core.slots.grad.abs().sum() > 0
+    if mode == "feedback":
+        assert model.net.action_planner.feedback_encoder.projection[0].weight.grad.abs().sum() > 0
+    for name, parameter in model.net.named_parameters():
+        if name in frozen:
+            torch.testing.assert_close(parameter, frozen[name], rtol=0, atol=0)
+            assert parameter.grad is None
+    cpu_rng, gpu_rng = torch.random.get_rng_state(), torch.cuda.get_rng_state()
+    _, first = model.validation_step({}, 10)
+    _, second = model.validation_step({}, 20)
+    torch.testing.assert_close(first, second, rtol=0, atol=0)
+    torch.testing.assert_close(torch.random.get_rng_state(), cpu_rng, rtol=0, atol=0)
+    torch.testing.assert_close(torch.cuda.get_rng_state(), gpu_rng, rtol=0, atol=0)
