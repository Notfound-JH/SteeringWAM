@@ -0,0 +1,56 @@
+"""Compare every native policy tensor loaded from the HF snapshot and converted DCP."""
+
+import argparse
+import json
+from pathlib import Path
+
+from cosmos_framework.inference.common.init import init_script
+
+init_script(env={"COSMOS_DEVICE": "cpu"})
+
+import torch
+import torch.distributed.checkpoint as dcp
+from torch.distributed.checkpoint import FileSystemReader
+
+from cosmos_framework.inference.model import Cosmos3OmniConfig, Cosmos3OmniModel
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, required=True)
+    parser.add_argument("--dcp", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    config = Cosmos3OmniConfig.from_pretrained(args.dcp / "model")
+    model = Cosmos3OmniModel.from_pretrained_dcp(args.source, config=config).model
+    reference = model.state_dict()
+    reader = FileSystemReader(args.dcp / "model")
+    metadata = reader.read_metadata()
+    if set(reference) != set(metadata.state_dict_metadata):
+        raise ValueError("Source and DCP native key sets differ")
+    mismatches = []
+    checked_bytes = 0
+    for name, expected in reference.items():
+        actual = torch.empty_like(expected)
+        dcp.load({name: actual}, storage_reader=reader, no_dist=True)
+        if not torch.equal(expected, actual):
+            mismatches.append(name)
+        checked_bytes += expected.numel() * expected.element_size()
+    report = dict(
+        source=str(args.source),
+        checkpoint=str(args.dcp),
+        native_tensors=len(reference),
+        checked_bytes=checked_bytes,
+        mismatches=mismatches,
+        bitwise_equal=not mismatches,
+        scope="native policy parameters/buffers only; not decoded actions or lazy vision tower",
+    )
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps(report, indent=2))
+    if mismatches:
+        raise ValueError("Converted DCP differs from source weights")
+
+
+if __name__ == "__main__":
+    main()
