+++ b/tools/prepare_edge_droid_assets.py
@@ -0,0 +1,94 @@
+"""Download the exact files referenced by a contiguous DROID episode prefix."""
+
+import argparse
+import json
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import pyarrow.parquet as parquet
+from huggingface_hub import hf_hub_download
+
+REVISION = "5c11a20accb11497270a5247a7f1e66ad04c956c"
+REPOSITORY = "nvidia/Cosmos3-DROID"
+
+
+def referenced_files(root: Path, episode_limit: int, *, validation_only: bool = False) -> tuple[list[str], list[int]]:
+    info = json.loads((root / "success/meta/info.json").read_text())
+    if not 1 <= episode_limit <= info["total_episodes"]:
+        raise ValueError("Episode limit must be within the released dataset")
+    video_keys = [key for key, feature in info["features"].items() if feature["dtype"] == "video"]
+    selected = None
+    if validation_only:
+        from cosmos_framework.data.generator.action.datasets.cosmos3_action_lerobot import split_episode_ids
+
+        selected = set(split_episode_ids(info["total_episodes"], 42, 0.03, "val"))
+    files, episodes = set(), []
+    for path in sorted((root / "success/meta/episodes").rglob("*.parquet")):
+        columns = [name for name in parquet.read_schema(path).names if not name.startswith("stats/")]
+        for row in parquet.read_table(path, columns=columns).to_pylist():
+            if row["episode_index"] >= episode_limit:
+                continue
+            episodes.append(row["episode_index"])
+            files.add(
+                "success/"
+                + info["data_path"].format(
+                    chunk_index=row["data/chunk_index"],
+                    file_index=row["data/file_index"],
+                )
+            )
+            for key in video_keys if selected is None or row["episode_index"] in selected else ():
+                files.add(
+                    "success/"
+                    + info["video_path"].format(
+                        video_key=key,
+                        chunk_index=row[f"videos/{key}/chunk_index"],
+                        file_index=row[f"videos/{key}/file_index"],
+                    )
+                )
+        if len(episodes) == episode_limit:
+            break
+    if sorted(episodes) != list(range(episode_limit)):
+        raise ValueError("Metadata does not contain a complete episode prefix")
+    return sorted(files), sorted(episodes)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, required=True)
+    parser.add_argument("--episode-limit", type=int, default=128)
+    parser.add_argument("--download", action="store_true")
+    parser.add_argument("--validation-only", action="store_true")
+    args = parser.parse_args()
+    files, episodes = referenced_files(args.root, args.episode_limit, validation_only=args.validation_only)
+    print(json.dumps({"revision": REVISION, "episode_count": len(episodes), "files": files}, indent=2), flush=True)
+    if not args.download:
+        return
+
+    def download(filename):
+        path = Path(hf_hub_download(REPOSITORY, filename, repo_type="dataset", revision=REVISION, local_dir=args.root))
+        if path.stat().st_size < 1024:
+            raise ValueError(f"Unexpectedly small payload: {filename}")
+        if filename.endswith(".parquet"):
+            parquet.read_metadata(path)
+        print(f"verified {filename}: {path.stat().st_size} bytes", flush=True)
+        return {"path": filename, "bytes": path.stat().st_size}
+
+    with ThreadPoolExecutor(max_workers=3) as pool:
+        records = list(pool.map(download, files))
+    manifest = dict(
+        repository=REPOSITORY,
+        revision=REVISION,
+        episode_limit=args.episode_limit,
+        episode_ids=episodes,
+        complete_for_prefix=not args.validation_only,
+        complete_for_validation_prefix=args.validation_only,
+        full_dataset=False,
+        files=records,
+    )
+    destination = args.root / f"{'validation' if args.validation_only else 'smoke'}_prefix_{args.episode_limit}.json"
+    destination.write_text(json.dumps(manifest, indent=2) + "\n")
+    print(f"Manifest: {destination}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
