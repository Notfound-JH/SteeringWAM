+#!/usr/bin/env bash
+set -euo pipefail
+
+export CUDA_VISIBLE_DEVICES=0,1,2,3
+export LD_LIBRARY_PATH=''
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT_DIR"
+: "${DROID_ROOT:?Set DROID_ROOT to the DROID LeRobot dataset}"
+: "${BASE_CHECKPOINT_PATH:?Set BASE_CHECKPOINT_PATH to the converted Edge-Policy-DROID DCP}"
+: "${WAN_VAE_PATH:?Set WAN_VAE_PATH to the video tokenizer weights}"
+: "${IMAGINAIRE_OUTPUT_ROOT:?Use a dedicated output root for this experiment}"
+PYTHON="${PYTHON:-$ROOT_DIR/.venv/bin/python}"
+RECIPE="${RECIPE:-examples/toml/sft_config/action_policy_droid_edge.toml}"
+if [[ ! -x "$PYTHON" || ! -f "$RECIPE" ]]; then
+    printf '%s\n' 'Python executable or recipe is missing.' >&2
+    exit 1
+fi
+if [[ "${DRYRUN:-0}" == "1" ]]; then
+    exec "$PYTHON" -m cosmos_framework.scripts.train --sft-toml="$RECIPE" --dryrun "$@"
+fi
+if [[ ! -d "$DROID_ROOT" || ! -d "$BASE_CHECKPOINT_PATH/model" || ! -f "$WAN_VAE_PATH" ]]; then
+    printf '%s\n' 'Training requires an existing DROID root, DCP model directory and VAE weights file.' >&2
+    exit 1
+fi
+exec "$PYTHON" -m torch.distributed.run --standalone --nproc-per-node=4 \
+    -m cosmos_framework.scripts.train --sft-toml="$RECIPE" "$@"
