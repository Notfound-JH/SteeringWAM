+import pytest
+import torch
+
+from cosmos_framework.model.generator.mot.recurrent_latent_planner import (
+    ActionPlanningResidual,
+    CandidateActionEncoder,
+    PlanningAttentionContext,
+    PlanningState,
+    RecurrentLatentPlanner,
+)
+from cosmos_framework.model.generator.mot.unified_mot import LayerTypes, MoTDecoderLayer
+from cosmos_framework.model.generator.reasoner.nemotron_3_dense_vl.configuration_nemotron_3_dense_vl import (
+    Nemotron3DenseVLTextConfig,
+)
+
+
+def _source_layer(hidden_size: int = 16):
+    config = Nemotron3DenseVLTextConfig(
+        hidden_size=hidden_size,
+        intermediate_size=hidden_size * 2,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=hidden_size // 4,
+        num_hidden_layers=1,
+    )
+    return MoTDecoderLayer(
+        config,
+        layer_idx=0,
+        layer_types=LayerTypes("nemotron_dense"),
+        qk_norm_for_text=False,
+        qk_norm_for_diffusion=True,
+    )
+
+
+def test_zero_residual_then_core_gradients_through_frozen_generator() -> None:
+    torch.manual_seed(42)
+    source = _source_layer()
+    original = {name: parameter.clone() for name, parameter in source.named_parameters()}
+    planner = RecurrentLatentPlanner([source], num_slots=4, lora_rank=2)
+    encoder = CandidateActionEncoder(3, 16)
+    residual = ActionPlanningResidual(source.self_attn, lora_rank=2, output_rank=4)
+    frozen_readout = torch.nn.Linear(16, 3).requires_grad_(False)
+    candidate = torch.randn(1, 4, 3, requires_grad=True)
+    anchors = torch.randn(1, 3, 16)
+    queries = torch.randn(4, 4, 4)
+    base = torch.randn(4, 16)
+    target = torch.randn(4, 3)
+    parameters = list(planner.parameters()) + list(encoder.parameters()) + list(residual.parameters())
+    optimizer = torch.optim.SGD([parameter for parameter in parameters if parameter.requires_grad], lr=0.1)
+    for iteration in range(3):
+        optimizer.zero_grad(set_to_none=True)
+        state = planner(anchors, torch.ones(1, 3, dtype=torch.bool), torch.ones(1), rounds=2)
+        feedback = encoder(
+            candidate, torch.zeros(1, 3), torch.arange(4).float()[None], torch.full((1,), 0.9), torch.full((1,), 0.8)
+        )
+        state = planner(
+            anchors, torch.ones(1, 3, dtype=torch.bool), torch.full((1,), 0.8), rounds=2, state=state, feedback=feedback
+        )
+        delta = residual(
+            queries,
+            state,
+            torch.zeros(4, dtype=torch.long),
+            torch.ones(4, dtype=torch.bool),
+            torch.ones(1, dtype=torch.bool),
+            torch.full((1,), 0.8),
+        )
+        if iteration == 0:
+            torch.testing.assert_close(delta, torch.zeros_like(base), rtol=0, atol=0)
+            torch.testing.assert_close(frozen_readout(base + delta), frozen_readout(base), rtol=0, atol=0)
+        loss = (frozen_readout(base + delta) - target).square().mean()
+        loss.backward()
+        assert residual.output_up.weight.grad.abs().sum() > 0
+        if iteration == 2:
+            assert planner.slots.grad.abs().sum() > 0
+            assert planner.layers[0].v_proj.lora_B.weight.grad.abs().sum() > 0
+            assert encoder.projection[0].weight.grad.abs().sum() > 0
+        assert candidate.grad is None
+        assert all(parameter.grad is None for parameter in frozen_readout.parameters())
+        optimizer.step()
+    for name, parameter in source.named_parameters():
+        torch.testing.assert_close(parameter, original[name], rtol=0, atol=0)
+        assert parameter.grad is None
+    for name, parameter in planner.layers[0].named_parameters():
+        if "lora_" not in name and name != "update_scale":
+            assert not parameter.requires_grad and parameter.grad is None
