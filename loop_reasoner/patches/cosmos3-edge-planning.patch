+def test_residual_writes_only_noisy_actions_of_conditional_sample() -> None:
+    residual = ActionPlanningResidual(_source_layer().self_attn, lora_rank=2, output_rank=4)
+    torch.nn.init.normal_(residual.output_up.weight)
+    slots = torch.randn(2, 3, 16)
+    queries = torch.randn(6, 4, 4)
+    sample_ids = torch.tensor([0, 0, 0, 1, 1, 2])
+    action_mask = torch.tensor([False, True, True, True, False, False])
+    conditional = torch.tensor([True, False])
+    sigma = torch.ones(2)
+    result = residual(queries, slots, sample_ids, action_mask, conditional, sigma)
+    assert not result[[0, 3, 4, 5]].any()
+    assert result[1:3].abs().sum() > 0
+    slots[1] += 100
+    torch.testing.assert_close(residual(queries, slots, sample_ids, action_mask, conditional, sigma), result)
+    assert not residual(queries, slots, sample_ids, action_mask, torch.zeros(2, dtype=torch.bool), sigma).any()
+    with pytest.raises(ValueError, match="real sample"):
