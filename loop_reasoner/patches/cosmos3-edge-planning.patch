@@ -0,0 +1,127 @@
+"""Configuration and explicit per-forward inputs for recurrent action planning."""
+
+from dataclasses import dataclass
+from typing import Literal
+
+import torch
+from torch import nn
+
+from cosmos_framework.model.generator.mot.recurrent_latent_planner import (
+    ActionPlanningResidual,
+    CandidateActionEncoder,
+    PlanningState,
+    RecurrentLatentPlanner,
+)
+
+
+@dataclass(frozen=True)
+class RecurrentPlanningConfig:
+    mode: Literal["static", "scheduled", "feedback"] = "feedback"
+    num_slots: int = 16
+    core_layers: int = 2
+    lora_rank: int = 16
+    output_rank: int = 64
+    rounds: int = 4
+    action_dim: int = 8
+    fps: float = 15.0
+    initialize_from_base: bool = True
+
+    def __post_init__(self) -> None:
+        if self.mode not in {"static", "scheduled", "feedback"}:
+            raise ValueError("Planning mode must be static, scheduled or feedback")
+        if any(
+            value < 1 for value in (self.num_slots, self.core_layers, self.lora_rank, self.output_rank, self.action_dim)
+        ):
+            raise ValueError("Planning dimensions and ranks must be positive")
+        if self.rounds not in {2, 4, 8} or self.fps <= 0:
+            raise ValueError("Planning requires an even tested round budget (2/4/8) and positive FPS")
+
+
+@dataclass(frozen=True)
+class PlanningRequest:
+    anchors: torch.Tensor
+    anchor_mask: torch.Tensor
+    current_state: torch.Tensor
+    sigma: torch.Tensor
+    initial_sigma: torch.Tensor
+    update_sigma: torch.Tensor
+    conditional_mask: torch.Tensor
+    after_feedback: bool = False
+    candidate: torch.Tensor | None = None
+    source_sigma: torch.Tensor | None = None
+    initial_slots: torch.Tensor | None = None
+
+
+class ActionPlanningModule(nn.Module):
+    """Registered under the VFM root so FSDP owns all planning computation."""
+
+    def __init__(self, source_layers: nn.ModuleList, config: RecurrentPlanningConfig):
+        super().__init__()
+        if config.core_layers > len(source_layers):
+            raise ValueError("Planning core is deeper than the source Reasoner")
+        self.config = config
+        self.core = RecurrentLatentPlanner(
+            list(source_layers[: config.core_layers]), config.num_slots, config.lora_rank
+        )
+        width = self.core.slots.shape[-1]
+        reference = self.core.slots
+        self.state_projection = nn.Linear(config.action_dim, width, device=reference.device, dtype=reference.dtype)
+        self.feedback_encoder = CandidateActionEncoder(config.action_dim, width).to(
+            device=reference.device, dtype=reference.dtype
+        )
+
+    def forward(self, request: PlanningRequest) -> PlanningState:
+        dtype = self.state_projection.weight.dtype
+        anchors = request.anchors.detach().to(dtype=dtype)
+        state_token = self.state_projection(request.current_state.detach().to(dtype=dtype))[:, None]
+        anchors = torch.cat((anchors, state_token), dim=1)
+        mask = torch.cat((request.anchor_mask, torch.ones_like(request.conditional_mask[:, None])), dim=1)
+        halfway = self.config.rounds // 2
+        slots = (
+            self.core(anchors, mask, request.initial_sigma.to(dtype=dtype), rounds=halfway)
+            if request.initial_slots is None
+            else request.initial_slots
+        )
+        if self.config.mode == "static" or request.after_feedback:
+            feedback = None
+            if self.config.mode == "feedback" and request.after_feedback:
+                if request.candidate is None or request.source_sigma is None:
+                    raise ValueError("Feedback update requires a candidate and its source sigma")
+                times = torch.arange(request.candidate.shape[1], device=anchors.device, dtype=dtype)[None]
+                times = times.expand(anchors.shape[0], -1) / self.config.fps
+                feedback = self.feedback_encoder(
+                    request.candidate.to(dtype=dtype),
+                    request.current_state.to(dtype=dtype),
+                    times,
+                    request.source_sigma.to(dtype=dtype),
+                    request.update_sigma.to(dtype=dtype),
+                )
+            slots = self.core(
+                anchors, mask, request.update_sigma.to(dtype=dtype), rounds=halfway, state=slots, feedback=feedback
+            )
+        return PlanningState(slots, request.conditional_mask, request.sigma.to(dtype=dtype))
+
+
+def register_action_planning(network: nn.Module, config: RecurrentPlanningConfig) -> None:
+    if getattr(network, "action_planner", None) is not None:
+        raise ValueError("Planning modules are already registered")
+    layers = network.language_model.model.layers
+    network.requires_grad_(False)
+    network.action_planner = ActionPlanningModule(layers, config)
+    for layer in layers:
+        layer.self_attn.planning_residual = ActionPlanningResidual(
+            layer.self_attn, config.lora_rank, config.output_rank
+        )
+
+
+@torch.no_grad()
+def initialize_action_planning(network: nn.Module) -> None:
+    planner = network.action_planner
+    layers = network.language_model.model.layers
+    planner.core.initialize_from(list(layers[: planner.config.core_layers]))
+    planner.state_projection.reset_parameters()
+    for module in planner.feedback_encoder.modules():
+        if isinstance(module, nn.Linear):
+            module.reset_parameters()
+    for layer in layers:
+        layer.self_attn.planning_residual.initialize_from(layer.self_attn)
