+"""Unsharded planning components; model registration and packed wiring are explicit."""
+
+import copy
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+import torch
+import torch.nn.functional as functional
+from torch import nn
+from torch.distributed.tensor import DTensor, distribute_tensor
+
+from cosmos_framework.utils.generator.lora import LoraInjectedLinear, init_lora_weights_post_materialization
+
+
+@dataclass(frozen=True)
+class PlanningState:
+    """Sample-level planning state, independent of a particular packed layout."""
+
+    slots: torch.Tensor
+    conditional_mask: torch.Tensor
+    sigma: torch.Tensor
+
+    def bind(self, pack: dict, noisy_action_indexes: torch.Tensor) -> "PlanningAttentionContext":
+        if pack.get("is_sharded", False):
+            raise ValueError("Planning state binding requires an unsharded pack")
+        full_indexes = pack["_full_indices"].to(device=self.slots.device, dtype=torch.long)
+        noisy_indexes = noisy_action_indexes.to(device=self.slots.device, dtype=torch.long)
+        if noisy_indexes.ndim != 1 or not bool(torch.isin(noisy_indexes, full_indexes).all()):
+            raise ValueError("Noisy action indices must belong to the packed GEN stream")
+        gen_count = pack["full_only_seq"].shape[0]
+        if full_indexes.numel() > gen_count:
+            raise ValueError("GEN index metadata exceeds its tensor length")
+        mask = torch.zeros(gen_count, device=self.slots.device, dtype=torch.bool)
+        mask[: full_indexes.numel()] = torch.isin(full_indexes, noisy_indexes)
+        return PlanningAttentionContext(self.slots, mask, self.conditional_mask, self.sigma)
+
+
+@dataclass(frozen=True)
+class PlanningAttentionContext:
+    """Explicit per-forward state; masks address the unsharded GEN stream."""
+
+    slots: torch.Tensor
+    noisy_action_mask: torch.Tensor
+    conditional_mask: torch.Tensor
+    sigma: torch.Tensor
+
+
+def _adapt_linear(source: nn.Linear, rank: int) -> LoraInjectedLinear:
+    if rank < 1 or source.weight.__class__ is not nn.Parameter:
+        raise ValueError("Planning initialization requires unsharded weights and a positive LoRA rank")
+    base = nn.Linear(
+        source.in_features,
+        source.out_features,
+        bias=source.bias is not None,
+        device=source.weight.device,
+        dtype=source.weight.dtype,
+    ).requires_grad_(False)
+    if not source.weight.is_meta:
+        _copy_base_parameters(base, source)
+    adapted = LoraInjectedLinear(base, rank=rank, alpha=rank)
+    if not source.weight.is_meta:
+        adapted.lora_A.to_empty(device=source.weight.device)
+        adapted.lora_B.to_empty(device=source.weight.device)
+        init_lora_weights_post_materialization(adapted)
+    return adapted
+
+
+@torch.no_grad()
+def _copy_base_parameters(target: nn.Module, source: nn.Module) -> None:
+    for name, parameter in target.named_parameters():
+        if "lora_" in name:
+            continue
+        source_parameter = source.get_parameter(name)
+        if source_parameter.is_meta or parameter.is_meta:
+            raise ValueError("Weight copying requires materialized source and target modules")
+        module_path, _, leaf = name.rpartition(".")
+        source_module = source.get_submodule(module_path) if module_path else source
+        value = source_parameter.full_tensor() if isinstance(source_parameter, DTensor) else source_parameter
+        if leaf == "weight" and isinstance(source_module, LoraInjectedLinear):
+            adapter_left = source_module.lora_B.weight
+            adapter_right = source_module.lora_A.weight
+            adapter_left = adapter_left.full_tensor() if isinstance(adapter_left, DTensor) else adapter_left
+            adapter_right = adapter_right.full_tensor() if isinstance(adapter_right, DTensor) else adapter_right
+            value = value + source_module._lora_scale * (adapter_left @ adapter_right)
+        if isinstance(parameter, DTensor):
+            value = distribute_tensor(value.detach(), parameter.device_mesh, parameter.placements)
+        parameter.copy_(value)
+
+
+class ReasonerPlanningLayer(nn.Module):
+    """Copy a dense MoT understanding layer into a shared, anchored slot update.
+
+    Slots attend noncausally to slots plus fixed anchors/feedback. Original text
+    RoPE is deliberately not applied to slots; this is an adapted architecture,
+    not an equivalent Reasoner forward or an already-trained planning policy.
+    """
+
+    def __init__(self, source: nn.Module, lora_rank: int) -> None:
+        super().__init__()
+        attention = source.self_attn
+        self.hidden_size = attention.hidden_size
+        self.num_heads = attention.num_attention_heads
+        self.num_kv_heads = attention.num_key_value_heads
+        self.head_dim = attention.head_dim
+        if self.num_heads % self.num_kv_heads:
+            raise ValueError("Planning attention requires divisible query/KV heads")
+        self.input_norm = copy.deepcopy(source.input_layernorm).requires_grad_(False)
+        self.post_norm = copy.deepcopy(source.post_attention_layernorm).requires_grad_(False)
+        self.q_norm = copy.deepcopy(attention.q_norm).requires_grad_(False)
+        self.k_norm = copy.deepcopy(attention.k_norm).requires_grad_(False)
+        self.q_proj = _adapt_linear(attention.q_proj, lora_rank)
+        self.k_proj = _adapt_linear(attention.k_proj, lora_rank)
+        self.v_proj = _adapt_linear(attention.v_proj, lora_rank)
+        self.o_proj = _adapt_linear(attention.o_proj, lora_rank)
+        self.mlp = copy.deepcopy(source.mlp).requires_grad_(False)
+        if not hasattr(self.mlp, "up_proj") or not hasattr(self.mlp, "down_proj"):
+            raise ValueError("The initial planning core supports dense Reasoner FFNs only")
+        for name in ("up_proj", "down_proj", "gate_proj"):
+            if hasattr(self.mlp, name):
+                setattr(self.mlp, name, _adapt_linear(getattr(self.mlp, name), lora_rank))
+        self.update_scale = nn.Parameter(attention.q_proj.weight.new_tensor([0.1]))
+
+    @torch.no_grad()
+    def initialize_from(self, source: nn.Module) -> None:
+        """Initialize a materialized meta-built core once, never on checkpoint resume."""
+        pairs = [
+            (self.input_norm, source.input_layernorm),
+            (self.post_norm, source.post_attention_layernorm),
+            (self.q_norm, source.self_attn.q_norm),
+            (self.k_norm, source.self_attn.k_norm),
+            (self.mlp, source.mlp),
+        ]
+        pairs.extend(
+            (getattr(self, name), getattr(source.self_attn, name)) for name in ("q_proj", "k_proj", "v_proj", "o_proj")
+        )
+        for target, origin in pairs:
+            _copy_base_parameters(target, origin)
+        init_lora_weights_post_materialization(self)
+        self.update_scale.fill_(0.1)
+
+    def forward(self, slots: torch.Tensor, memory: torch.Tensor, memory_mask: torch.Tensor) -> torch.Tensor:
+        batch_size, slot_count, _ = slots.shape
+        context = self.input_norm(torch.cat((slots, memory), dim=1))
+        queries = self.q_norm(
+            self.q_proj(self.input_norm(slots)).view(batch_size, slot_count, self.num_heads, self.head_dim)
+        )
+        keys = self.k_norm(self.k_proj(context).view(batch_size, -1, self.num_kv_heads, self.head_dim))
+        values = self.v_proj(context).view(batch_size, -1, self.num_kv_heads, self.head_dim)
+        valid = torch.cat(
+            (torch.ones((batch_size, slot_count), dtype=torch.bool, device=slots.device), memory_mask), dim=1
+        )
+        attended = (
+            functional.scaled_dot_product_attention(
+                queries.transpose(1, 2),
+                keys.transpose(1, 2),
+                values.transpose(1, 2),
+                attn_mask=valid[:, None, None, :],
+                enable_gqa=True,
+            )
+            .transpose(1, 2)
+            .reshape(batch_size, slot_count, -1)
+        )
+        updated = slots + self.update_scale * self.o_proj(attended)
+        return updated + self.update_scale * self.mlp(self.post_norm(updated))
+
+
+class CandidateActionEncoder(nn.Module):
+    """Detach candidate trajectories, but retain gradients through their encoder."""
+
+    def __init__(self, action_dim: int, hidden_size: int) -> None:
+        super().__init__()
+        self.action_dim = action_dim
+        self.projection = nn.Sequential(
+            nn.Linear(2 * action_dim + 3, hidden_size), nn.SiLU(), nn.Linear(hidden_size, hidden_size)
+        )
+
+    def forward(
+        self,
+        candidate: torch.Tensor,
+        current_state: torch.Tensor,
+        action_times: torch.Tensor,
+        source_sigma: torch.Tensor,
+        update_sigma: torch.Tensor,
+    ) -> torch.Tensor:
+        if candidate.ndim != 3 or candidate.shape[-1] != self.action_dim:
+            raise ValueError("Candidate must be [batch, horizon, action_dim]")
+        batch_size, horizon, _ = candidate.shape
+        if current_state.shape != (batch_size, self.action_dim) or action_times.shape != (batch_size, horizon):
+            raise ValueError("State and physical action times must match the candidate batch")
+        if source_sigma.shape != (batch_size,) or update_sigma.shape != (batch_size,):
+            raise ValueError("Feedback sigma must have one value per sample")
+        features = torch.cat(
+            (
+                candidate.detach(),
+                current_state[:, None, :].expand(-1, horizon, -1),
+                action_times[:, :, None],
+                source_sigma[:, None, None].expand(-1, horizon, -1),
+                update_sigma[:, None, None].expand(-1, horizon, -1),
+            ),
+            dim=-1,
+        )
+        return self.projection(features)
+
+
+class RecurrentLatentPlanner(nn.Module):
+    """Fixed slots with explicit caller-owned state and depth-shared core layers."""
+
+    def __init__(self, reasoner_layers: Sequence[nn.Module], num_slots: int = 16, lora_rank: int = 16) -> None:
+        super().__init__()
+        if not reasoner_layers or num_slots < 1:
+            raise ValueError("Planning requires at least one source layer and one slot")
+        self.layers = nn.ModuleList([ReasonerPlanningLayer(layer, lora_rank) for layer in reasoner_layers])
+        hidden_size = self.layers[0].hidden_size
+        if any(layer.hidden_size != hidden_size for layer in self.layers):
+            raise ValueError("Planning core hidden widths must match")
+        reference = reasoner_layers[0].self_attn.q_proj.weight
+        self.slots = nn.Parameter(torch.empty(num_slots, hidden_size, device=reference.device, dtype=reference.dtype))
+        nn.init.normal_(self.slots, std=0.02)
+        self.noise_embedding = nn.Linear(1, hidden_size, device=reference.device, dtype=reference.dtype)
+
+    @torch.no_grad()
+    def initialize_from(self, reasoner_layers: Sequence[nn.Module]) -> None:
+        if len(reasoner_layers) != len(self.layers):
+            raise ValueError("Source layer count must match the registered planning core")
+        for layer, source in zip(self.layers, reasoner_layers):
+            layer.initialize_from(source)
+        nn.init.normal_(self.slots, std=0.02)
+        self.noise_embedding.reset_parameters()
+
+    def forward(
+        self,
+        anchors: torch.Tensor,
+        anchor_mask: torch.Tensor,
+        sigma: torch.Tensor,
+        *,
+        rounds: int,
+        state: torch.Tensor | None = None,
+        feedback: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        if type(rounds) is not int or rounds < 1:
+            raise ValueError("rounds must be a positive integer")
+        if anchors.ndim != 3 or anchors.shape[-1] != self.slots.shape[-1]:
+            raise ValueError("Anchors must be [batch, tokens, hidden_size]")
+        batch_size = anchors.shape[0]
+        if anchor_mask.shape != anchors.shape[:2] or anchor_mask.dtype != torch.bool:
+            raise ValueError("anchor_mask must be boolean [batch, tokens]")
+        if not bool(anchor_mask.any(dim=1).all()) or sigma.shape != (batch_size,):
+            raise ValueError("Each sample needs a valid anchor and a scalar noise level")
+        slots = self.slots.unsqueeze(0).expand(batch_size, -1, -1) if state is None else state
+        if slots.shape != (batch_size, *self.slots.shape):
+            raise ValueError("Planning state must preserve the batch and fixed slot capacity")
+        memory = torch.cat((anchors, self.noise_embedding(sigma[:, None])[:, None, :]), dim=1)
+        mask = torch.cat((anchor_mask, torch.ones((batch_size, 1), dtype=torch.bool, device=anchors.device)), dim=1)
+        if feedback is not None:
+            if feedback.ndim != 3 or feedback.shape[0] != batch_size or feedback.shape[-1] != anchors.shape[-1]:
+                raise ValueError("Feedback must match anchor batch and hidden size")
+            memory = torch.cat((memory, feedback), dim=1)
+            mask = torch.cat((mask, torch.ones(feedback.shape[:2], dtype=torch.bool, device=anchors.device)), dim=1)
+        for _ in range(rounds):
+            for layer in self.layers:
+                slots = layer(slots, memory, mask)
+        return slots
+
+
+class ActionPlanningResidual(nn.Module):
+    """Independent attention, directly writing only enabled noisy action queries.
+
+    Queries must already be normalized, pre-RoPE and unsharded. Sample IDs/masks
+    come from the packer, not token position heuristics. This component does not
+    modify the baseline attention or its softmax denominator.
+    """
+
+    def __init__(self, generator_attention: nn.Module, lora_rank: int = 16, output_rank: int = 64) -> None:
+        super().__init__()
+        if output_rank < 1:
+            raise ValueError("output_rank must be positive")
+        self.hidden_size = generator_attention.hidden_size
+        self.num_heads = generator_attention.num_attention_heads
+        self.num_kv_heads = generator_attention.num_key_value_heads
+        self.head_dim = generator_attention.head_dim
+        self.key_projection = _adapt_linear(generator_attention.k_proj_moe_gen, lora_rank)
+        self.value_projection = _adapt_linear(generator_attention.v_proj_moe_gen, lora_rank)
+        self.key_norm = copy.deepcopy(generator_attention.k_norm_moe_gen).requires_grad_(False)
+        reference = generator_attention.q_proj_moe_gen.weight
+        self.output_down = nn.Linear(
+            self.num_heads * self.head_dim, output_rank, bias=False, device=reference.device, dtype=reference.dtype
+        )
+        self.output_up = nn.Linear(
+            output_rank, self.hidden_size, bias=False, device=reference.device, dtype=reference.dtype
+        )
+        nn.init.zeros_(self.output_up.weight)
+        self.gate = nn.Linear(1, 1, device=reference.device, dtype=reference.dtype)
+        nn.init.zeros_(self.gate.weight)
+        nn.init.zeros_(self.gate.bias)
+
+    @torch.no_grad()
+    def initialize_from(self, generator_attention: nn.Module) -> None:
+        """Seed base projections after materialization, preserving the zero-output gate."""
+        _copy_base_parameters(self.key_projection, generator_attention.k_proj_moe_gen)
+        _copy_base_parameters(self.value_projection, generator_attention.v_proj_moe_gen)
+        _copy_base_parameters(self.key_norm, generator_attention.k_norm_moe_gen)
+        init_lora_weights_post_materialization(self)
+        self.output_down.reset_parameters()
+        nn.init.zeros_(self.output_up.weight)
+        nn.init.zeros_(self.gate.weight)
+        nn.init.zeros_(self.gate.bias)
+
+    def forward(
+        self,
+        queries: torch.Tensor,
+        slots: torch.Tensor,
+        sample_ids: torch.Tensor,
+        noisy_action_mask: torch.Tensor,
+        conditional_mask: torch.Tensor,
+        sigma: torch.Tensor,
+    ) -> torch.Tensor:
+        if queries.ndim != 3 or queries.shape[1:] != (self.num_heads, self.head_dim):
+            raise ValueError("Planning queries must be unsharded [tokens, heads, head_dim]")
+        if slots.ndim != 3 or slots.shape[-1] != self.hidden_size or slots.shape[1] == 0:
+            raise ValueError("Planning slots must be [batch, nonempty slots, hidden_size]")
+        batch_size = slots.shape[0]
+        if sample_ids.shape != queries.shape[:1] or sample_ids.dtype != torch.long:
+            raise ValueError("sample_ids must be int64 with one entry per query")
+        if noisy_action_mask.shape != sample_ids.shape or noisy_action_mask.dtype != torch.bool:
+            raise ValueError("noisy_action_mask must be boolean with one entry per query")
+        if (
+            conditional_mask.shape != (batch_size,)
+            or conditional_mask.dtype != torch.bool
+            or sigma.shape != (batch_size,)
+        ):
+            raise ValueError("Conditional mask and sigma must have one entry per sample")
+        selected_ids = sample_ids[noisy_action_mask]
+        if bool(((selected_ids < 0) | (selected_ids >= batch_size)).any()):
+            raise ValueError("Noisy action queries must belong to a real sample")
+        output = queries.new_zeros((queries.shape[0], self.hidden_size))
+        for sample_index in range(batch_size):
+            indices = torch.where(noisy_action_mask & (sample_ids == sample_index) & conditional_mask[sample_index])[0]
+            if indices.numel() == 0:
+                continue
+            memory = slots[sample_index]
+            keys = self.key_norm(self.key_projection(memory).view(-1, self.num_kv_heads, self.head_dim))
+            values = self.value_projection(memory).view(-1, self.num_kv_heads, self.head_dim)
+            attended = (
+                functional.scaled_dot_product_attention(
+                    queries[indices].transpose(0, 1).unsqueeze(0),
+                    keys.transpose(0, 1).unsqueeze(0),
+                    values.transpose(0, 1).unsqueeze(0),
+                    enable_gqa=True,
+                )
+                .squeeze(0)
+                .transpose(0, 1)
+                .reshape(indices.numel(), -1)
+            )
+            residual = torch.sigmoid(
+                self.gate(sigma[sample_index].reshape(1, 1).to(dtype=self.gate.weight.dtype))
+            ) * self.output_up(self.output_down(attended))
+            output = output.index_copy(0, indices, residual)
+        return output
