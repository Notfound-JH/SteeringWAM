+        torch.nn.init.normal_(layer.self_attn.planning_residual.output_up.weight, std=0.02)
+    reference = None
+    for intervention in ("correct", "reverse_time", "zero_candidate", "disabled"):
+        with paired_denoiser_probe(model, intervention) as captured, paired_loss_probe(model) as branches:
+            metrics, loss = model.validation_step({}, 0)
+        assert len(branches) == 2
+        torch.testing.assert_close(sum(part["action"] + part["vision"] for part in branches) / 2, loss)
+        if intervention != "disabled":
+            assert torch.isfinite(captured["feedback_encoding"]).all()
+            assert torch.isfinite(captured["planning_slots"]).all()
+        assert torch.isfinite(loss)
+        if reference is None:
+            reference = captured
+        else:
+            assert_paired(reference, captured, same_feedback=intervention != "disabled")
+        assert "bridge_flow_matching_loss_action" in metrics
+    assert "denoise" not in model.__dict__
+
+
+@pytest.mark.level(1)
+@pytest.mark.gpus(1)
+def test_b4_b5_share_initial_parameters_and_supervised_inputs():
+    from cosmos_framework.model.generator.planning_diagnostics import assert_paired, paired_denoiser_probe
+
+    torch.manual_seed(42)
+    feedback = _tiny_training_model("feedback")
+    torch.manual_seed(42)
+    scheduled = _tiny_training_model("scheduled")
+    for name, value in feedback.net.state_dict().items():
+        torch.testing.assert_close(value, scheduled.net.state_dict()[name], rtol=0, atol=0)
+    with paired_denoiser_probe(feedback, "correct") as reference:
+        feedback.validation_step({}, 0)
+    with paired_denoiser_probe(scheduled, "correct") as captured:
+        scheduled.validation_step({}, 0)
+    assert_paired(reference, captured)
+
+
+@pytest.mark.level(1)
+@pytest.mark.gpus(MAX_GPUS)
+def test_four_rank_recurrent_training_initialization_and_ema(tmp_path) -> None:
+    import torch.distributed as distributed
+    import torch.distributed.checkpoint as checkpoint
+    from torch.distributed.algorithms._checkpoint.checkpoint_wrapper import checkpoint_wrapper
+    from torch.distributed.checkpoint.state_dict import (
+        get_model_state_dict,
+        get_state_dict,
+        set_model_state_dict,
+        set_state_dict,
+    )
+    from torch.distributed.device_mesh import init_device_mesh
+    from torch.distributed.fsdp import MixedPrecisionPolicy, fully_shard
+
+    from cosmos_framework.model.generator.mot.planning_request import initialize_action_planning
+    from cosmos_framework.utils.generator.dtensor_helper import DTensorFastEmaModelUpdater
+
+    if int(os.environ.get("WORLD_SIZE", "1")) != 4:
+        pytest.skip("Requires torchrun with four ranks")
+    if os.environ.get("CUDA_VISIBLE_DEVICES") != "0,1,2,3":
+        pytest.skip("Only physical GPUs 0-3 are authorized; disable pytest-env with -p no:env")
+    local_rank = int(os.environ["LOCAL_RANK"])
+    torch.cuda.set_device(local_rank)
+    distributed.init_process_group("nccl", timeout=timedelta(seconds=120))
+    try:
+        model = _tiny_training_model()
+        model.net.float()
+        model.net_ema = copy.deepcopy(model.net).requires_grad_(False)
+        mesh = init_device_mesh("cuda", (4,))
+        for network in (model.net, model.net_ema):
+            network.language_model.model.layers = torch.nn.ModuleList(
+                [checkpoint_wrapper(layer) for layer in network.language_model.model.layers]
+            )
+            for layer in network.language_model.model.layers:
+                fully_shard(
+                    layer,
+                    mesh=mesh,
+                    mp_policy=MixedPrecisionPolicy(
+                        param_dtype=torch.bfloat16, reduce_dtype=torch.float32, cast_forward_inputs=False
+                    ),
+                )
+            fully_shard(
+                network,
+                mesh=mesh,
+                mp_policy=MixedPrecisionPolicy(
+                    param_dtype=torch.bfloat16, reduce_dtype=torch.float32, cast_forward_inputs=False
+                ),
+            )
+        initialize_action_planning(model.net)
+        updater = DTensorFastEmaModelUpdater()
+        updater.copy_to(model.net, model.net_ema)
+        from cosmos_framework.utils.generator.fused_adam import FusedAdam
+
+        optimizer = FusedAdam([parameter for parameter in model.net.parameters() if parameter.requires_grad], lr=1e-3)
+        before = model.net.action_planner.core.slots.to_local().detach().clone()
+        for iteration in range(3):
+            optimizer.zero_grad(set_to_none=True)
+            _, loss = model.training_step({}, iteration)
+            loss.backward()
+            assert torch.isfinite(loss)
+            optimizer.step()
+            updater.update_average(model.net, model.net_ema, beta=0.9)
+        local_slots = model.net.action_planner.core.slots.to_local()
+        if local_slots.numel():
+            assert not torch.equal(local_slots, before)
+        assert tuple(model.net.state_dict()) == tuple(model.net_ema.state_dict())
+        for parameter in model.net_ema.parameters():
+            assert torch.isfinite(parameter.to_local()).all()
+        checkpoint_paths = [str(tmp_path / "planning_dcp") if local_rank == 0 else None]
+        distributed.broadcast_object_list(checkpoint_paths, src=0)
+        net_state, optimizer_state = get_state_dict(model.net, optimizer)
+        saved_slots = model.net.action_planner.core.slots.to_local().detach().clone()
+        saved_ema = model.net_ema.action_planner.core.slots.to_local().detach().clone()
+        state = {"net": net_state, "ema": get_model_state_dict(model.net_ema), "optimizer": optimizer_state}
+        checkpoint.save(state, checkpoint_id=checkpoint_paths[0])
+        with torch.no_grad():
+            model.net.action_planner.core.slots.add_(10)
+            model.net_ema.action_planner.core.slots.add_(20)
+        checkpoint.load(state, checkpoint_id=checkpoint_paths[0])
+        set_state_dict(model.net, optimizer, model_state_dict=state["net"], optim_state_dict=state["optimizer"])
+        set_model_state_dict(model.net_ema, state["ema"])
+        torch.testing.assert_close(model.net.action_planner.core.slots.to_local(), saved_slots, rtol=0, atol=0)
+        torch.testing.assert_close(model.net_ema.action_planner.core.slots.to_local(), saved_ema, rtol=0, atol=0)
+        distributed.barrier()
+    finally:
+        distributed.destroy_process_group()
