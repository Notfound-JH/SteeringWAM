+"""Paired-FM planning variants from a common Edge-DROID SFT checkpoint."""
+
+import copy
+
+from hydra.core.config_store import ConfigStore
+
+from cosmos_framework.configs.base.experiment.action.posttrain_config.action_policy_droid_edge import (
+    action_policy_droid_edge,
+)
+from cosmos_framework.model.generator.recurrent_action_policy_model import (
+    PairedActionPolicyControlModel,
+    RecurrentActionPolicyModel,
+)
+
+
+def build_recurrent_experiment(mode: str):
+    experiment = copy.deepcopy(action_policy_droid_edge)
+    experiment.model._target_ = RecurrentActionPolicyModel
+    experiment.model.planning = dict(
+        mode=mode,
+        num_slots=16,
+        core_layers=2,
+        lora_rank=16,
+        output_rank=64,
+        rounds=4,
+        action_dim=8,
+        fps=15.0,
+        initialize_from_base=True,
+    )
+    experiment.optimizer.keys_to_select = ["action_planner.", "planning_residual."]
+    experiment.optimizer.lr = 1e-4
+    experiment.optimizer.lr_multipliers = {}
+    experiment.checkpoint.keys_to_skip_loading = ["net_ema.", "action_planner.", "planning_residual."]
+    experiment.dataloader_train.dataloader.datasets.droid.dataset.cfg_dropout_rate = 0.0
+    experiment.job.name = f"action_policy_droid_edge_{mode}"
+    if mode == "control":
+        experiment.model._target_ = PairedActionPolicyControlModel
+        experiment.model.planning.mode = "static"
+        experiment.model.planning.initialize_from_base = False
+        experiment.optimizer = copy.deepcopy(action_policy_droid_edge.optimizer)
+        experiment.checkpoint.keys_to_skip_loading = ["net_ema."]
+    return experiment
+
+
+for planning_mode in ("static", "scheduled", "feedback", "control"):
+    ConfigStore.instance().store(
+        group="experiment",
+        package="_global_",
+        name=f"action_policy_droid_edge_{planning_mode}",
+        node=build_recurrent_experiment(planning_mode),
+    )
