+def test_registered_planning_request_budget_and_gradient() -> None:
+    from dataclasses import replace
+
+    from cosmos_framework.model.generator.mot.planning_request import (
+        ActionPlanningModule,
+        PlanningRequest,
+        RecurrentPlanningConfig,
+    )
+
+    core = ActionPlanningModule(
+        torch.nn.ModuleList([_source_layer()]), RecurrentPlanningConfig(core_layers=1, num_slots=3, lora_rank=2)
+    )
+    candidate = torch.randn(1, 4, 8, requires_grad=True)
+    request = PlanningRequest(
+        anchors=torch.randn(1, 2, 16),
+        anchor_mask=torch.ones(1, 2, dtype=torch.bool),
+        current_state=torch.zeros(1, 8),
+        sigma=torch.tensor([0.8]),
+        initial_sigma=torch.ones(1),
+        update_sigma=torch.tensor([0.83]),
+        conditional_mask=torch.ones(1, dtype=torch.bool),
+    )
+    before = core(request)
+    after = core(replace(request, after_feedback=True, candidate=candidate, source_sigma=torch.tensor([0.94])))
+    assert before.slots.shape == after.slots.shape == (1, 3, 16)
+    after.slots.square().mean().backward()
+    assert candidate.grad is None
+    assert core.feedback_encoder.projection[0].weight.grad.abs().sum() > 0
+    assert core.state_projection.weight.grad is not None
+    with pytest.raises(ValueError, match="candidate"):
+        core(replace(request, after_feedback=True))
+
