+    sigma = torch.ones(2)
+    parameter_ids = [id(parameter) for parameter in planner.parameters()]
+    first = planner(anchors, mask, sigma, rounds=2)
+    saved = first.clone()
+    continued = planner(anchors, mask, sigma, rounds=2, state=first)
+    torch.testing.assert_close(continued, planner(anchors, mask, sigma, rounds=4))
+    torch.testing.assert_close(first, saved, rtol=0, atol=0)
+    assert parameter_ids == [id(parameter) for parameter in planner.parameters()]
+    changed = anchors.clone()
+    changed[1] += 10
+    torch.testing.assert_close(planner(changed, mask, sigma, rounds=2)[0], first[0])
