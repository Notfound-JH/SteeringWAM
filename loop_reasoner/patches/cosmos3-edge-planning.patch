+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from cosmos_framework.model.generator.mot.planning_request import PlanningRequest
+from cosmos_framework.model.generator.planning_diagnostics import paired_denoiser_probe, select_episode_windows
+
+
+def test_episode_bootstrap_uses_episodes_not_windows():
+    from cosmos_framework.model.generator.planning_diagnostics import episode_bootstrap
+
+    result = episode_bootstrap({0: [-2.0] * 50, 1: [1.0]})
+    assert result["mean"] == -0.5 and result["episodes"] == 2
+    assert result["improved"] == 1 and result["degraded"] == 1
+    assert result["ci95"] == [-2.0, 1.0]
+
+
+def test_comparison_rejects_unpaired_inputs_and_aggregates_by_episode():
+    import copy
+
+    from cosmos_framework.model.generator.planning_diagnostics import compare_reports
+
+    row = dict(
+        weights="ema",
+        split="val",
+        source_index=0,
+        episode_id=1,
+        dataset_index=0,
+        intervention="correct",
+        anchor_fingerprint="anchor",
+        bridge_fingerprint="bridge",
+        bridge_sigma=[0.5],
+        source_sigma=[0.9],
+        anchor_flow_matching_loss_action=2.0,
+        bridge_flow_matching_loss_action=2.0,
+        joints=2.0,
+        gripper=2.0,
+        weighted_action=20.0,
+        weighted_vision=30.0,
+        objective=50.0,
+    )
+    first = dict(
+        status="completed",
+        manifest=[],
+        sample_preparation_seed=42,
+        validation_noise_seed=1729,
+        loss_weights={},
+        checkpoint_selection="200",
+        method="B0-CONT",
+        checkpoint="a",
+        rows=[row],
+    )
+    second = copy.deepcopy(first)
+    second.update(method="B4", checkpoint="b")
+    second["rows"][0]["joints"] = 1.0
+    stats = compare_reports([first, second])["comparisons"][0]["metrics"]["joints"]
+    assert stats["mean"] == -1.0 and stats["improved"] == 1
+    second["rows"].append(dict(second["rows"][0], intervention="zero_candidate", joints=0.5))
+    interventions = compare_reports([first, second])["intervention_comparisons"]
+    assert len(interventions) == 1
+    assert interventions[0]["metrics"]["joints"]["mean"] == -0.5
+    second["rows"][0]["bridge_fingerprint"] = "wrong"
+    with pytest.raises(ValueError, match="Unpaired bridge_fingerprint"):
+        compare_reports([first, second])
+
+
+def test_selection_is_episode_balanced_deterministic_and_preserves_indices():
+    dataset = SimpleNamespace(_episode_records=[(0, 100, 10, 8), (0, 300, 20, 2), (0, 500, 5, 7)])
+    selected = select_episode_windows(dataset, episodes=3, windows=2)
+    assert len(selected) == 6
+    assert sorted(item["dataset_index"] for item in selected) == [0, 9, 10, 29, 30, 34]
+    assert selected == select_episode_windows(dataset, episodes=3, windows=2)
+    assert sorted(item["global_frame_index"] for item in selected) == [100, 109, 300, 319, 500, 504]
+
+
+def test_probe_changes_only_feedback_restores_method_and_does_not_mutate_input():
+    seen = []
+
+    def original(**kwargs):
+        seen.append(kwargs)
+        return {"preds_action": [torch.ones(3, 2)]}
+
+    model = SimpleNamespace(denoise=original)
+    request = PlanningRequest(
+        torch.ones(1, 2, 4),
+        torch.ones(1, 2, dtype=torch.bool),
+        torch.zeros(1, 2),
+        torch.tensor([0.6]),
+        torch.ones(1),
+        torch.tensor([0.8]),
+        torch.ones(1, dtype=torch.bool),
+        after_feedback=True,
+        candidate=torch.arange(6).reshape(1, 3, 2).float(),
+        source_sigma=torch.tensor([0.9]),
+    )
+    packed = SimpleNamespace(action=SimpleNamespace(tokens=[torch.ones(3, 2)]))
+    with torch.no_grad(), paired_denoiser_probe(model, "reverse_time") as captured:
+        model.denoise(planning_request=request, data_batch_packed=packed)
+        torch.testing.assert_close(seen[-1]["planning_request"].candidate, request.candidate.flip(1))
+        torch.testing.assert_close(captured["candidate"], request.candidate)
+    assert model.denoise is original
+    with pytest.raises(RuntimeError, match="evaluation only"), paired_denoiser_probe(model, "correct"):
+        model.denoise(planning_request=request, data_batch_packed=packed)
+    assert model.denoise is original
+    with torch.no_grad(), paired_denoiser_probe(model, "disabled"):
+        model.denoise(planning_request=request, data_batch_packed=packed)
+    assert "planning_request" not in seen[-1]
+    donor = request.candidate + 0.25
+    with torch.no_grad(), paired_denoiser_probe(model, "same_task", replacement=donor) as captured:
+        model.denoise(planning_request=request, data_batch_packed=packed)
+        torch.testing.assert_close(captured["used_candidate"], donor)
+        torch.testing.assert_close(captured["candidate"], request.candidate)
+    assert model.denoise is original
+    with pytest.raises(ValueError, match="explicit donor"), paired_denoiser_probe(model, "mismatched"):
+        pass
