+@pytest.mark.parametrize("gen_only", [False, True])
+def test_native_attention_planning_residual_preserves_und_and_zero_baseline(gen_only: bool) -> None:
+    from cosmos_framework.data.generator.sequence_packing.runtime import (
+        from_und_gen_splits,
+        get_gen_seq,
+        get_und_seq,
+        prepare_sequence_pack_metadata,
+    )
+
+    layer = _source_layer()
+    attention = layer.self_attn
+    und_count = 0 if gen_only else 2
+    metadata = prepare_sequence_pack_metadata(
+        sample_lens=[und_count + 3],
+        split_lens=[und_count, 3],
+        attn_modes=["causal", "full"],
+        device=torch.device("cpu"),
+        packed_und_token_indexes=torch.arange(und_count),
+    )
+    pack = from_und_gen_splits(
+        torch.randn(und_count, 16), torch.randn(3, 16), metadata.as_sequence_pack_fields() | {"is_sharded": False}
+    )
+    cos = from_und_gen_splits(torch.ones(und_count, 4), torch.ones(3, 4), pack)
+    sin = from_und_gen_splits(torch.zeros(und_count, 4), torch.zeros(3, 4), pack)
+
+    def dispatch(queries, keys, values, mask, **kwargs):
+        return from_und_gen_splits(get_und_seq(queries).flatten(1), get_gen_seq(queries).flatten(1), queries), None
+
+    attention.dispatch_attention_fn = dispatch
+    baseline, _, _ = layer(pack, None, (cos, sin), gen_only=gen_only)
+    attention.planning_residual = ActionPlanningResidual(attention, lora_rank=2, output_rank=4)
+    context = PlanningAttentionContext(
+        slots=torch.randn(1, 3, 16, requires_grad=True),
+        noisy_action_mask=torch.tensor([False, True, True]),
+        conditional_mask=torch.ones(1, dtype=torch.bool),
+        sigma=torch.ones(1),
+    )
+    zero, _, _ = layer(pack, None, (cos, sin), gen_only=gen_only, planning_context=context)
+    torch.testing.assert_close(get_gen_seq(zero), get_gen_seq(baseline), rtol=0, atol=0)
+    torch.testing.assert_close(get_und_seq(zero), get_und_seq(baseline), rtol=0, atol=0)
+    torch.nn.init.normal_(attention.planning_residual.output_up.weight)
+    changed, _, _ = layer(pack, None, (cos, sin), gen_only=gen_only, planning_context=context)
+    torch.testing.assert_close(get_gen_seq(changed)[0], get_gen_seq(baseline)[0], rtol=0, atol=0)
+    torch.testing.assert_close(get_und_seq(changed), get_und_seq(baseline), rtol=0, atol=0)
+    assert not torch.equal(get_gen_seq(changed)[1:], get_gen_seq(baseline)[1:])
+    get_gen_seq(changed).square().sum().backward()
+    assert context.slots.grad is not None and context.slots.grad.abs().sum() > 0
+    with pytest.raises(ValueError, match="unsharded GEN"):
+        attention(pack | {"is_sharded": True}, None, (cos, sin), planning_context=context)
+
