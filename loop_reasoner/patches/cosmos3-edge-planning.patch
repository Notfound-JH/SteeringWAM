@@ -0,0 +1,391 @@
+"""Episode-balanced paired-FM diagnostics on an existing checkpoint, without training."""
+
+from cosmos_framework.inference.common.init import init_script
+
+init_script()
+
+import argparse
+import copy
+import json
+import random
+import statistics
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.distributed.checkpoint as dcp
+
+from cosmos_framework.data.generator.action.datasets.action_sft_dataset import get_action_droid_sft_dataset
+from cosmos_framework.data.generator.joint_dataloader import IterativeJointDataLoader
+from cosmos_framework.inference.args import OmniSetupOverrides
+from cosmos_framework.inference.common.init import init_output_dir
+from cosmos_framework.inference.inference import OmniInference
+from cosmos_framework.model.generator.planning_diagnostics import (
+    INTERVENTIONS,
+    assert_paired,
+    compare_reports,
+    paired_denoiser_probe,
+    paired_loss_probe,
+    select_episode_windows,
+    tensor_delta,
+)
+from cosmos_framework.scripts.action_policy_server_utils import (
+    disable_runtime_ema_for_frozen_config,
+    maybe_init_distributed,
+)
+
+METRICS = (
+    "loss_anchor",
+    "loss_bridge",
+    "anchor_flow_matching_loss_action",
+    "anchor_flow_matching_loss_vision",
+    "bridge_flow_matching_loss_action",
+    "bridge_flow_matching_loss_vision",
+)
+
+
+def load_weight_family(model, checkpoint: Path, family: str):
+    reader = dcp.FileSystemReader(checkpoint / "model")
+    metadata = reader.read_metadata().state_dict_metadata
+    prefix = "net." if family == "raw" else "net_ema."
+    tensors = model.net.state_dict()
+    for name, tensor in tensors.items():
+        key = prefix + name
+        if key not in metadata or tuple(metadata[key].size) != tuple(tensor.shape):
+            raise ValueError(f"Missing/incompatible {family} tensor: {name}")
+    state = {prefix + name: tensor for name, tensor in tensors.items()}
+    dcp.load(state, storage_reader=reader, no_dist=True)
+    model.net.load_state_dict({name: state[prefix + name] for name in tensors}, strict=True)
+    return {"prefix": prefix, "tensor_count": len(tensors), "compute_dtype": str(next(model.net.parameters()).dtype)}
+
+
+def build_batch(sample):
+    return {
+        key: [[value]]
+        if key in IterativeJointDataLoader._MULTI_ITEM_KEYS
+        else [value.unsqueeze(0)]
+        if isinstance(value, torch.Tensor)
+        else [value]
+        for key, value in sample.items()
+    }
+
+
+def summarize(rows):
+    summary = []
+    for family, split, intervention in sorted({(row["weights"], row["split"], row["intervention"]) for row in rows}):
+        selected = [
+            row for row in rows if (row["weights"], row["split"], row["intervention"]) == (family, split, intervention)
+        ]
+        by_episode = {}
+        for row in selected:
+            by_episode.setdefault(row["episode_id"], []).append(row)
+        values = {
+            key: statistics.mean(statistics.mean(row[key] for row in group) for group in by_episode.values())
+            for key in ("objective", *METRICS, "bridge_action_delta_rms", "paired_objective_delta")
+        }
+        summary.append(
+            dict(
+                weights=family,
+                split=split,
+                intervention=intervention,
+                episodes=len(by_episode),
+                windows=len(selected),
+                **values,
+            )
+        )
+    return summary
+
+
+def write_report(path, report):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(report, indent=2, allow_nan=False) + "\n")
+    temporary.replace(path)
+
+
+def evaluate(model, record, family, intervention, *, replacement=None, reference=None):
+    with (
+        torch.no_grad(),
+        paired_denoiser_probe(model, intervention, replacement=replacement) as captured,
+        paired_loss_probe(model) as branches,
+    ):
+        metrics, loss = model.validation_step(copy.deepcopy(record["batch"]), 0)
+    row = {key: value for key, value in record.items() if key != "batch"}
+    row.update(
+        weights=family,
+        intervention=intervention,
+        objective=loss.item(),
+        **{key: metrics[key].item() for key in METRICS},
+    )
+    for name in ("action", "vision", "joints", "gripper"):
+        row[f"weighted_{name}" if name in {"action", "vision"} else name] = (
+            sum(part[name].item() for part in branches) / 2
+        )
+    if reference is None:
+        reference = captured
+    else:
+        assert_paired(reference, captured, same_feedback=intervention != "disabled")
+    row["changes"] = {
+        key: tensor_delta(reference[key], captured[key])
+        for key in ("feedback_encoding", "planning_slots")
+        if key in captured and key in reference
+    }
+    row["changes"]["action_velocity"] = tensor_delta(
+        reference["bridge_prediction_action"][1:, :8], captured["bridge_prediction_action"][1:, :8]
+    )
+    row["bridge_action_delta_rms"] = row["changes"]["action_velocity"]["rms"]
+    row["source_sigma"] = captured["source_sigma"].tolist()
+    row["bridge_sigma"] = captured["bridge_sigma"].tolist()
+    row["anchor_fingerprint"] = captured["anchor_fingerprint"]
+    row["bridge_fingerprint"] = captured["bridge_fingerprint"]
+    if "feedback_encoding" in captured:
+        row["encoding_l2"] = torch.linalg.vector_norm(captured["feedback_encoding"]).item()
+    row["prediction_action_l2"] = torch.linalg.vector_norm(captured["bridge_prediction_action"][1:, :8]).item()
+    return row, captured
+
+
+def gradient_probe(model, batch):
+    selected = {
+        name: parameter
+        for name, parameter in model.net.named_parameters()
+        if name == "action_planner.core.slots"
+        or name.startswith("action_planner.feedback_encoder.")
+        or "planning_residual.output_up." in name
+    }
+    if not selected:
+        raise ValueError("Gradient probe requires planning modules")
+    flags = {name: parameter.requires_grad for name, parameter in model.net.named_parameters()}
+    try:
+        model.net.requires_grad_(False)
+        for parameter in selected.values():
+            parameter.requires_grad_(True)
+        with torch.enable_grad(), paired_loss_probe(model) as branches:
+            model.validation_step.__wrapped__(model, copy.deepcopy(batch), 0)
+            gradients = {}
+            for modality in ("action", "vision"):
+                loss = sum(part[modality] for part in branches) / 2
+                values = torch.autograd.grad(
+                    loss, tuple(selected.values()), retain_graph=modality == "action", allow_unused=True
+                )
+                gradients[modality] = {
+                    name: torch.zeros_like(parameter, device="cpu", dtype=torch.float32)
+                    if grad is None
+                    else grad.detach().float().cpu()
+                    for (name, parameter), grad in zip(selected.items(), values)
+                }
+        result = {}
+        for group, pattern in (("slots", "core.slots"), ("encoder", "feedback_encoder"), ("output_up", "output_up")):
+            vectors = {
+                modality: torch.cat([value.flatten() for name, value in mapping.items() if pattern in name])
+                for modality, mapping in gradients.items()
+            }
+            action_norm, video_norm = (torch.linalg.vector_norm(vectors[key]).item() for key in ("action", "vision"))
+            result[group] = dict(
+                action_norm=action_norm,
+                video_norm=video_norm,
+                cosine=torch.dot(vectors["action"], vectors["vision"]).item() / max(action_norm * video_norm, 1e-20),
+            )
+        return dict(
+            scope="selected planning parameter groups; actual weighted objectives; no optimizer step",
+            groups=result,
+            parameters=list(selected),
+        )
+    finally:
+        for name, parameter in model.net.named_parameters():
+            parameter.requires_grad_(flags[name])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--run-dir", type=Path)
+    parser.add_argument("--checkpoint", type=Path)
+    parser.add_argument("--data-root", type=Path)
+    parser.add_argument("--compare", type=Path, nargs="+")
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument(
+        "--episodes", type=int, default=5, help="Maximum episode count per split; use a large value for all"
+    )
+    parser.add_argument("--windows", type=int, default=2)
+    parser.add_argument("--episode-limit", type=int, default=128)
+    parser.add_argument("--splits", nargs="+", choices=("train", "val"), default=["val"])
+    parser.add_argument("--weights", nargs="+", choices=("raw", "ema"), default=["raw", "ema"])
+    parser.add_argument("--mechanism", action="store_true")
+    parser.add_argument("--gradient-batches", type=int, default=0)
+    parser.add_argument("--label", default="B5")
+    args = parser.parse_args()
+    if args.compare:
+        write_report(args.report, compare_reports([json.loads(path.read_text()) for path in args.compare]))
+        return
+    if any(value is None for value in (args.run_dir, args.checkpoint, args.data_root)):
+        parser.error("Evaluation requires --run-dir, --checkpoint and --data-root")
+    if args.gradient_batches < 0:
+        parser.error("--gradient-batches must be nonnegative")
+    if args.episode_limit > 128 and "train" in args.splits:
+        parser.error("Expanded resources are validation-only; do not evaluate unavailable training videos")
+    if args.checkpoint.name != "iter_000000200":
+        parser.error("This locked comparison uses the fixed iteration-200 checkpoint")
+    maybe_init_distributed()
+    if torch.distributed.get_world_size() != 1:
+        raise ValueError("Diagnostics require single-rank inference")
+    setup = OmniSetupOverrides(
+        checkpoint_path=str(args.checkpoint),
+        config_file=str(args.run_dir / "config.yaml"),
+        output_dir=args.run_dir / "paired_diagnostics",
+        sampler="unipc",
+        guardrails=False,
+        use_torch_compile=False,
+        use_ema_weights=False,
+        experiment_overrides=["model.planning.initialize_from_base=false"],
+    ).build_setup()
+    init_output_dir(setup.output_dir)
+    pipeline = OmniInference.create(disable_runtime_ema_for_frozen_config(setup))
+    model = pipeline.model
+    model.eval()
+    model.net.requires_grad_(False)
+    from cosmos_framework.model.generator.recurrent_action_policy_model import PairedActionPolicyControlModel
+
+    actual_label = (
+        "B0-CONT"
+        if isinstance(model, PairedActionPolicyControlModel)
+        else (
+            "B4"
+            if model.planning_config.mode == "scheduled"
+            else "B5"
+            if model.planning_config.mode == "feedback"
+            else "B3"
+        )
+    )
+    if args.label != actual_label or (args.mechanism and actual_label != "B5"):
+        raise ValueError(f"Method label/probe mode differs from the loaded model: {actual_label}")
+    records = []
+    for split in args.splits:
+        dataset = get_action_droid_sft_dataset(
+            root=str(args.data_root),
+            split=split,
+            episode_limit=args.episode_limit,
+            video_backend="pyav",
+            cfg_dropout_rate=0,
+            use_image_augmentation=False,
+            iterable_shuffle=False,
+            resolution="480",
+            format_prompt_as_json=True,
+            tokenizer_config=model.vlm_config.tokenizer,
+        )
+        for selected in select_episode_windows(dataset._dataset, episodes=args.episodes, windows=args.windows):
+            random.seed(42 + selected["dataset_index"])
+            np.random.seed(42 + selected["dataset_index"])
+            torch.random.default_generator.manual_seed(42 + selected["dataset_index"])
+            sample = dataset[selected["dataset_index"]]
+            prompt = json.loads(sample["ai_caption"])
+            task = " ".join(action["description"] for action in prompt["actions"])
+            records.append(dict(split=split, **selected, task=task, batch=build_batch(sample)))
+    train_ids = {row["episode_id"] for row in records if row["split"] == "train"}
+    val_ids = {row["episode_id"] for row in records if row["split"] == "val"}
+    assert train_ids.isdisjoint(val_ids)
+    report = dict(
+        checkpoint=str(args.checkpoint),
+        status="running",
+        selection_seed=42,
+        sample_preparation_seed="42 + dataset_index (Python/NumPy/CPU Torch)",
+        validation_noise_seed=1729,
+        method=args.label,
+        checkpoint_selection="fixed iteration 200; EMA primary, raw sensitivity; no best-checkpoint selection",
+        episode_limit=args.episode_limit,
+        loss_weights=dict(
+            action=model.config.rectified_flow_training_config.action_loss_weight,
+            vision=model.config.rectified_flow_training_config.loss_scale,
+        ),
+        gradient_probes=[],
+        manifest=[{key: value for key, value in row.items() if key != "batch"} for row in records],
+        weight_loading={},
+        rows=[],
+        summary=[],
+        scope="legal paired-FM offline evaluation; optional same-checkpoint interventions; not rollout",
+        limitations=[
+            "Zero candidate and reversed time are distribution-shift interventions.",
+            "Disabled planning uses the frozen common SFT base, not an equal-exposure trained control.",
+            "Episode prefix only; windows within episodes are correlated. Raw and EMA are not independent runs.",
+            "Synthetic paired-FM gains need separate actual-sampler and environment verification.",
+        ],
+    )
+    write_report(args.report, report)
+    started = time.monotonic()
+    for family in args.weights:
+        report["weight_loading"][family] = load_weight_family(model, args.checkpoint, family)
+        pool = []
+        for record in records:
+            row, captured = evaluate(model, record, family, "correct")
+            row["paired_objective_delta"] = 0.0
+            pool.append((record, row, captured))
+            report["rows"].append(row)
+            write_report(args.report, report)
+        for record, correct, reference in pool:
+            for intervention in (
+                ("repeat_correct", *INTERVENTIONS[1:], "same_task", "mismatched") if args.mechanism else ()
+            ):
+                donor = None
+                if intervention in {"same_task", "mismatched"}:
+                    options = [
+                        (other, capture)
+                        for other, _, capture in pool
+                        if other["split"] == record["split"]
+                        and other["dataset_index"] != record["dataset_index"]
+                        and (
+                            (other["episode_id"] == record["episode_id"])
+                            if intervention == "same_task"
+                            else (
+                                other["episode_id"] != record["episode_id"]
+                                and len(set(other["task"].lower().split()) & set(record["task"].lower().split()))
+                                / max(1, len(set(other["task"].lower().split()) | set(record["task"].lower().split())))
+                                < 0.35
+                            )
+                        )
+                    ]
+                    if not options:
+                        raise ValueError(f"No {intervention} donor; check task labels and window coverage")
+                    donor, source = min(
+                        options,
+                        key=lambda item: (item[1]["current_state"] - reference["current_state"]).square().mean().item(),
+                    )
+                    replacement = source["candidate"]
+                else:
+                    replacement = None
+                row, captured = evaluate(
+                    model, record, family, intervention, replacement=replacement, reference=reference
+                )
+                if donor is not None:
+                    row["donor"] = {key: value for key, value in donor.items() if key != "batch"}
+                    row["donor_state_rms"] = (
+                        (source["current_state"] - reference["current_state"]).square().mean().sqrt().item()
+                    )
+                row["paired_objective_delta"] = row["objective"] - correct["objective"]
+                report["rows"].append(row)
+                report["summary"] = summarize(report["rows"])
+                write_report(args.report, report)
+            print(
+                f"{family} {record['split']} episode={record['episode_id']} frame={record['global_frame_index']} complete",
+                flush=True,
+            )
+        for record in records[: args.gradient_batches]:
+            report["gradient_probes"].append(
+                dict(
+                    weights=family,
+                    episode_id=record["episode_id"],
+                    dataset_index=record["dataset_index"],
+                    **gradient_probe(model, record["batch"]),
+                )
+            )
+            write_report(args.report, report)
+        report["summary"] = summarize(report["rows"])
+    report.update(status="completed", elapsed_seconds=time.monotonic() - started)
+    write_report(args.report, report)
+    print(json.dumps(report["summary"], indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    finally:
+        if torch.distributed.is_initialized():
+            torch.distributed.destroy_process_group()
