@@ -0,0 +1,409 @@
+"""Recurrent action policy lifecycle and paired-FM training."""
+
+from collections.abc import Mapping
+from dataclasses import replace
+
+import torch
+
+from cosmos_framework.model.generator.action_policy_sft_model import ActionPolicySFTModel
+from cosmos_framework.model.generator.diffusion.samplers.fm_solvers_unipc import FlowUniPCMultistepScheduler
+from cosmos_framework.model.generator.diffusion.samplers.unipc import UniPCSampler
+from cosmos_framework.model.generator.mot.planning_request import (
+    PlanningRequest,
+    RecurrentPlanningConfig,
+    initialize_action_planning,
+    register_action_planning,
+)
+from cosmos_framework.model.generator.mot.recurrent_latent_planner import PlanningState
+from cosmos_framework.model.generator.omni_mot_model import OmniMoTModel
+
+
+class RecurrentActionPolicyModel(ActionPolicySFTModel):
+    def __init__(self, config, planning: RecurrentPlanningConfig | Mapping):
+        self.planning_config = (
+            planning if isinstance(planning, RecurrentPlanningConfig) else RecurrentPlanningConfig(**dict(planning))
+        )
+        self._planning_ready = False
+        if config.parallelism.context_parallel_shard_degree != 1 or config.parallelism.cfg_parallel_shard_degree != 1:
+            raise ValueError("Recurrent planning currently requires CP=1 and CFG parallelism=1")
+        if config.compile.enabled or config.parallelism.fsdp_cpu_offload:
+            raise ValueError("Initial recurrent training requires compile and CPU offload disabled")
+        inference = config.rectified_flow_inference_config
+        if (
+            inference.num_train_timesteps != 1000
+            or inference.shift != 1
+            or inference.use_dynamic_shifting
+            or inference.scheduler_type != "unipc"
+        ):
+            raise ValueError(
+                "Recurrent policy requires the validated 1000-timestep UniPC configuration with base shift=1"
+            )
+        super().__init__(config)
+
+    def install_attention_dispatch(self, net: torch.nn.Module) -> None:
+        super().install_attention_dispatch(net)
+        register_action_planning(net, self.planning_config)
+
+    def load_pretrained_model_if_needed(self, *, has_resumable_checkpoint: bool, has_load_path: bool) -> None:
+        if not has_resumable_checkpoint and not has_load_path:
+            raise ValueError("Recurrent policy requires a loaded policy checkpoint")
+        super().load_pretrained_model_if_needed(
+            has_resumable_checkpoint=has_resumable_checkpoint,
+            has_load_path=has_load_path,
+        )
+        if not has_resumable_checkpoint and self.planning_config.initialize_from_base:
+            initialize_action_planning(self.net)
+            if self.config.ema.enabled:
+                if tuple(dict(self.net.named_parameters())) != tuple(dict(self.net_ema.named_parameters())):
+                    raise ValueError("Planning net/EMA parameter registration differs")
+                self.net_ema_worker.copy_to(src_model=self.net, tgt_model=self.net_ema)
+        self._planning_ready = True
+
+    def _planning_schedule(self):
+        scheduler = FlowUniPCMultistepScheduler(num_train_timesteps=1000, shift=1.0)
+        scheduler.set_timesteps(4, device=self.tensor_kwargs["device"], shift=5.0)
+        return scheduler
+
+    def on_inference_weights_loaded(self) -> None:
+        if self.planning_config.initialize_from_base:
+            raise ValueError("Loading a trained planning policy requires model.planning.initialize_from_base=false")
+        if getattr(self.net, "action_planner", None) is None:
+            raise ValueError("Loaded policy has no registered planning modules")
+        self._planning_ready = True
+
+    @torch.no_grad()
+    def generate_samples_from_batch(self, data_batch, net=None, **kwargs):
+        if not self._planning_ready:
+            raise RuntimeError("Load the planning checkpoint before inference")
+        if torch.distributed.is_initialized() and torch.distributed.get_world_size() != 1:
+            raise ValueError("Recurrent sampling currently supports single-rank inference only")
+        if getattr(self, "_diffusion_cache_installed", False):
+            raise ValueError("Disable diffusion residual caching for recurrent planning")
+        sampler = kwargs.get("sampler") or self.sampler
+        if (
+            not isinstance(sampler, UniPCSampler)
+            or sampler.cfg.shift != 1
+            or sampler.cfg.use_dynamic_shifting
+            or sampler.cfg.num_train_timesteps != 1000
+        ):
+            raise ValueError("Recurrent sampling requires unshifted UniPC initialization")
+        defaults = dict(
+            num_steps=4,
+            shift=5.0,
+            guidance=3.0,
+            guidance_interval=[960, 1001],
+            normalize_cfg=False,
+            use_batched_cfg=False,
+        )
+        for name, value in defaults.items():
+            if name in kwargs and kwargs[name] != value:
+                raise ValueError(f"Initial recurrent sampling requires {name}={value}")
+            kwargs[name] = value
+        if kwargs.get("velocity_postprocess_builder") is not None or kwargs.get("planning_state_provider") is not None:
+            raise ValueError("Recurrent policy owns the planning state and disallows velocity postprocessing")
+        kwargs.setdefault("restart_after_steps", (1,) if self.planning_config.mode != "static" else ())
+        target = net or self.net
+        was_training = target.training
+        try:
+            target.eval()
+            return super().generate_samples_from_batch(
+                data_batch,
+                net=target,
+                planning_session_builder=self._build_planning_session,
+                **kwargs,
+            )
+        finally:
+            target.train(was_training)
+
+    def _build_planning_session(self, *, net, sequence_plans, gen_data_clean, cond_tokens, initial_noise):
+        batch_size = gen_data_clean.batch_size
+        if (
+            gen_data_clean.x0_tokens_action is None
+            or len(gen_data_clean.x0_tokens_action) != batch_size
+            or len(gen_data_clean.x0_tokens_vision) != batch_size
+            or gen_data_clean.x0_tokens_sound is not None
+            or gen_data_clean.x0_tokens_lidar is not None
+        ):
+            raise ValueError("Recurrent sampling requires DROID action+video layout")
+        schedule = self._planning_schedule()
+        initial_vision, initial_action = [], []
+        for index, noise in enumerate(initial_noise):
+            vision, action = gen_data_clean.x0_tokens_vision[index], gen_data_clean.x0_tokens_action[index]
+            if noise.numel() != vision.numel() + action.numel():
+                raise ValueError("Initial noise does not match the DROID action/video layout")
+            initial_vision.append(noise[: vision.numel()].reshape(vision.shape))
+            initial_action.append(noise[vision.numel() :].reshape(action.shape))
+        prefill_data = replace(gen_data_clean, x0_tokens_vision=initial_vision, x0_tokens_action=initial_action)
+        packed = self._pack_input_sequence(
+            sequence_plans, cond_tokens, prefill_data, schedule.timesteps[0].float().expand(batch_size, 1).cpu()
+        )
+        for mask in packed.action.condition_mask:
+            if not bool(mask[0].all()) or bool(mask[1:].any()):
+                raise ValueError("Recurrent sampling requires exactly action row 0 as state")
+        packed.to_cuda()
+        anchors = self.denoise(net=net, data_batch_packed=packed, return_planning_anchors=True)
+        sigmas = schedule.sigmas.to(**self.tensor_kwargs_fp32)
+        request = PlanningRequest(
+            anchors["planning_anchors"].detach(),
+            anchors["planning_anchor_mask"],
+            torch.stack([item[0, : self.planning_config.action_dim] for item in gen_data_clean.x0_tokens_action]),
+            sigmas[0].expand(batch_size),
+            sigmas[0].expand(batch_size),
+            sigmas[2].expand(batch_size),
+            torch.ones(batch_size, dtype=torch.bool, device=sigmas.device),
+        )
+        state = net(packed_seq=packed, planning_request=request, planning_only=True)["planning_slots"]
+        initial_slots = state
+        scheduled_slots = None
+        if self.planning_config.mode == "scheduled":
+            scheduled_slots = net(
+                packed_seq=packed,
+                planning_request=replace(request, initial_slots=initial_slots, after_feedback=True),
+                planning_only=True,
+            )["planning_slots"]
+        timestep_indices = {int(timestep): index for index, timestep in enumerate(schedule.timesteps.tolist())}
+
+        def provider(timestep):
+            if timestep not in timestep_indices:
+                raise ValueError("Model timestep is not on the planning session grid")
+            return PlanningState(state, request.conditional_mask, sigmas[timestep_indices[timestep]].expand(batch_size))
+
+        def callback(events):
+            nonlocal state
+            if events[0].step.step_index != 1 or self.planning_config.mode == "static":
+                return
+            if self.planning_config.mode == "scheduled":
+                state = scheduled_slots
+                return
+            candidates = []
+            for index, event in enumerate(events):
+                action = gen_data_clean.x0_tokens_action[index]
+                offset = gen_data_clean.x0_tokens_vision[index].numel()
+                if event.step.predicted_clean_sample.numel() != offset + action.numel():
+                    raise ValueError("Feedback event and DROID action layout differ")
+                candidates.append(
+                    event.step.predicted_clean_sample[offset:].reshape(action.shape)[
+                        1:, : self.planning_config.action_dim
+                    ]
+                )
+                if abs(event.step.model_input_sigma - float(sigmas[1])) > 1e-6:
+                    raise ValueError("Feedback source sigma does not match the session")
+            update = replace(
+                request,
+                initial_slots=initial_slots,
+                after_feedback=True,
+                candidate=torch.stack(candidates).detach(),
+                source_sigma=sigmas[1].expand(batch_size),
+            )
+            state = net(packed_seq=packed, planning_request=update, planning_only=True)["planning_slots"]
+
+        return provider, callback
+
+    def training_step(self, data_batch: dict, iteration: int):
+        if not self._planning_ready:
+            raise RuntimeError("Load and initialize the policy before recurrent training")
+        tokens, plans, clean, memory_info, resolutions, pixel_shapes = self._get_training_inputs(data_batch, iteration)
+        batch_size = clean.batch_size
+        if (
+            clean.is_image_batch
+            or clean.x0_tokens_action is None
+            or len(clean.x0_tokens_action) != batch_size
+            or len(clean.x0_tokens_vision) != batch_size
+            or clean.x0_tokens_sound is not None
+            or clean.x0_tokens_lidar is not None
+            or memory_info.get("skip_text", False)
+        ):
+            raise ValueError("Paired policy training requires conditional action+video samples, one video per sample")
+        if self.config.rectified_flow_training_config.independent_action_schedule:
+            raise ValueError("Paired policy training requires a shared action/video sigma")
+        schedule = self._planning_schedule()
+        low_index = int(torch.randint(2, 4, ()).item())
+        high_sigma = schedule.sigmas[1].to(**self.tensor_kwargs_fp32).expand(batch_size)
+        low_sigma = schedule.sigmas[low_index].to(**self.tensor_kwargs_fp32).expand(batch_size)
+        high_time = schedule.timesteps[1].float().expand(batch_size, 1)
+        low_time = schedule.timesteps[low_index].float().expand(batch_size, 1)
+        anchor_time, anchor_sigma = self._get_train_noise_level_vision(
+            batch_size=batch_size,
+            is_image_batch=False,
+            resolutions=resolutions,
+            num_vision_latent_frames=[item.shape[2] for item in clean.x0_tokens_vision],
+            num_tokens=[item.shape[2] * item.shape[3] * item.shape[4] for item in clean.x0_tokens_vision],
+            iteration=iteration,
+        )
+        if anchor_sigma.shape != (batch_size, 1):
+            raise ValueError("Paired policy training requires one anchor sigma per sample")
+
+        high_pack = self._pack_input_sequence(plans, tokens, clean, high_time.cpu())
+        for index, mask in enumerate(high_pack.action.condition_mask):
+            if mask.shape[0] < 2 or not bool(mask[0].all()) or bool(mask[1:].any()):
+                raise ValueError("DROID planning requires exactly action row 0 as current state")
+            if clean.raw_action_dim is not None and int(clean.raw_action_dim[index]) != self.planning_config.action_dim:
+                raise ValueError("Planning action dimension differs from the dataset")
+        noisy = self._add_noise_to_input(clean, high_pack, high_sigma[:, None], iteration=iteration)
+        sample_ids = tuple(f"{iteration}:{index}" for index in range(batch_size))
+        vision_pair = self.rectified_flow_video.get_paired_interpolation(
+            sample_ids=sample_ids,
+            clean=clean.x0_tokens_vision,
+            epsilon=noisy.epsilon_vision,
+            sigma_high=list(high_sigma),
+            sigma_low=list(low_sigma),
+            condition_mask=high_pack.vision.condition_mask,
+        )
+        action_pair = self.rectified_flow_action.get_paired_interpolation(
+            sample_ids=sample_ids,
+            clean=clean.x0_tokens_action,
+            epsilon=noisy.epsilon_action,
+            sigma_high=list(high_sigma),
+            sigma_low=list(low_sigma),
+            condition_mask=high_pack.action.condition_mask,
+            valid_mask=clean.action_valid_mask,
+        )
+
+        def at_sigma(pair, sigmas):
+            return [
+                (value + (sigmas[index] - high_sigma[index]) * pair.velocity_target[index]).to(**self.tensor_kwargs)
+                for index, value in enumerate(pair.sample_high)
+            ]
+
+        def pack_at(text_tokens, times, sigmas):
+            noised = replace(
+                noisy,
+                xt_tokens_vision=at_sigma(vision_pair, sigmas),
+                xt_tokens_action=at_sigma(action_pair, sigmas),
+                vt_target_vision=list(vision_pair.velocity_target),
+                vt_target_action=list(action_pair.velocity_target),
+                sigmas_vision=sigmas[:, None],
+                sigmas_action=sigmas[:, None],
+            )
+            packed = self._pack_input_sequence(plans, text_tokens, clean, times.cpu())
+            self._replace_clean_with_noised(packed, noised)
+            packed.to_cuda()
+            return packed, noised
+
+        high_pack, high_noised = pack_at(tokens, high_time, high_sigma)
+        was_training = self.net.training
+        with torch.no_grad():
+            try:
+                self.net.eval()
+                prefill = self.denoise(data_batch_packed=high_pack, return_planning_anchors=True)
+            finally:
+                self.net.train(was_training)
+        request = PlanningRequest(
+            anchors=prefill["planning_anchors"].detach(),
+            anchor_mask=prefill["planning_anchor_mask"],
+            current_state=torch.stack([item[0, : self.planning_config.action_dim] for item in clean.x0_tokens_action]),
+            sigma=high_sigma,
+            initial_sigma=schedule.sigmas[0].to(**self.tensor_kwargs_fp32).expand(batch_size),
+            update_sigma=schedule.sigmas[2].to(**self.tensor_kwargs_fp32).expand(batch_size),
+            conditional_mask=torch.ones(batch_size, device=high_sigma.device, dtype=torch.bool),
+        )
+        with torch.no_grad():
+            try:
+                self.net.eval()
+                source = self.denoise(data_batch_packed=high_pack, planning_request=request)
+            finally:
+                self.net.train(was_training)
+            candidate = torch.stack(
+                [
+                    (state.float() - high_sigma[index] * velocity.float())[1:, : self.planning_config.action_dim]
+                    for index, (state, velocity) in enumerate(zip(high_noised.xt_tokens_action, source["preds_action"]))
+                ]
+            )
+
+        keep_condition = torch.rand(batch_size, device=high_sigma.device) >= 0.1
+        _, uncond_tokens = self._get_inference_text_tokens(data_batch, has_negative_prompt=False)
+        anchor_tokens = [
+            tokens[index] if bool(keep_condition[index]) else uncond_tokens[index] for index in range(batch_size)
+        ]
+        anchor_pack, anchor_noised = pack_at(anchor_tokens, anchor_time, anchor_sigma.flatten().to(high_sigma))
+        low_pack, low_noised = pack_at(tokens, low_time, low_sigma)
+        anchor_output = self.denoise(
+            data_batch_packed=anchor_pack,
+            planning_request=replace(
+                request, sigma=anchor_sigma.flatten().to(high_sigma), conditional_mask=keep_condition
+            ),
+        )
+        bridge_output = self.denoise(
+            data_batch_packed=low_pack,
+            planning_request=replace(
+                request, sigma=low_sigma, after_feedback=True, candidate=candidate.detach(), source_sigma=high_sigma
+            ),
+        )
+        anchor_loss, anchor_metrics = self._compute_losses(
+            anchor_output,
+            anchor_pack,
+            anchor_noised,
+            anchor_time,
+            False,
+        )
+        bridge_loss, bridge_metrics = self._compute_losses(
+            bridge_output,
+            low_pack,
+            low_noised,
+            low_time,
+            False,
+        )
+        metrics = {name: (value + bridge_metrics[name]) / 2 for name, value in anchor_metrics.items()}
+        for branch, branch_metrics in (("anchor", anchor_metrics), ("bridge", bridge_metrics)):
+            for modality in ("action", "vision"):
+                metrics[f"{branch}_flow_matching_loss_{modality}"] = branch_metrics[
+                    f"flow_matching_loss_{modality}"
+                ].detach()
+        metrics.update(
+            loss_anchor=anchor_loss.detach(),
+            loss_bridge=bridge_loss.detach(),
+            planning_source_sigma=high_sigma.detach(),
+            sigma=low_sigma[:, None],
+            x0=clean.x0_tokens_vision,
+            xt=low_noised.xt_tokens_vision,
+            model_pred=bridge_output["preds_vision"],
+            condition_mask_vision=low_pack.vision.condition_mask,
+            condition_mask_action=low_pack.action.condition_mask,
+            batch_size=batch_size,
+            und_token_length=low_pack.text_indexes.shape[0],
+            gen_token_length=low_pack.sequence_length - low_pack.text_indexes.shape[0],
+            vision_token_length=len(low_pack.vision.sequence_indexes),
+            action_token_length=len(low_pack.action.sequence_indexes),
+            sound_token_length=0,
+            split_lens=low_pack.split_lens,
+            attn_modes=low_pack.attn_modes,
+            vae_pixel_shapes=pixel_shapes,
+            is_image_batch=False,
+            _action_family=clean.action_family,
+            planning_generator_forwards=4,
+            planning_supervised_forwards=2,
+            planning_core_rounds=(
+                0
+                if isinstance(self, PairedActionPolicyControlModel)
+                else self.planning_config.rounds * (3 if self.planning_config.mode == "static" else 2)
+            ),
+        )
+        return metrics, (anchor_loss + bridge_loss) / 2
+
+
+class PairedActionPolicyControlModel(RecurrentActionPolicyModel):
+    """Equal-supervision control: train existing LoRA/heads, without a planner."""
+
+    def install_attention_dispatch(self, net):
+        OmniMoTModel.install_attention_dispatch(self, net)
+
+    def on_inference_weights_loaded(self) -> None:
+        self._planning_ready = True
+
+    def load_pretrained_model_if_needed(self, *, has_resumable_checkpoint, has_load_path):
+        if not has_resumable_checkpoint and not has_load_path:
+            raise ValueError("Paired control requires the common SFT checkpoint")
+        OmniMoTModel.load_pretrained_model_if_needed(
+            self,
+            has_resumable_checkpoint=has_resumable_checkpoint,
+            has_load_path=has_load_path,
+        )
+        if not has_resumable_checkpoint and self.config.ema.enabled:
+            self.net_ema_worker.copy_to(src_model=self.net, tgt_model=self.net_ema)
+        self._planning_ready = True
+
+    def denoise(self, *args, planning_request=None, **kwargs):
+        return OmniMoTModel.denoise(self, *args, **kwargs)
+
+    def generate_samples_from_batch(self, *args, **kwargs):
+        return OmniMoTModel.generate_samples_from_batch(self, *args, **kwargs)
