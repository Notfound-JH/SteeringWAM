+"""Reload an actual recurrent DCP and generate actions from a held-out DROID window."""
+
+from cosmos_framework.inference.common.init import init_script
+
+init_script()
+
+import argparse
+import json
+import time
+from pathlib import Path
+
+import torch
+
+from cosmos_framework.data.generator.action.datasets.action_sft_dataset import get_action_droid_sft_dataset
+from cosmos_framework.data.generator.joint_dataloader import IterativeJointDataLoader
+from cosmos_framework.inference.args import OmniSetupOverrides
+from cosmos_framework.inference.common.init import init_output_dir
+from cosmos_framework.inference.inference import OmniInference
+from cosmos_framework.scripts.action_policy_server_utils import (
+    disable_runtime_ema_for_frozen_config,
+    maybe_init_distributed,
+)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--run-dir", type=Path, required=True)
+    parser.add_argument("--checkpoint", type=Path, help="Explicit checkpoint directory; defaults to the two-step smoke checkpoint")
+    parser.add_argument("--data-root", type=Path, required=True)
+    parser.add_argument("--tokenizer", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    checkpoint = args.checkpoint if args.checkpoint is not None else args.run_dir / "checkpoints/iter_000000002"
+    if not (checkpoint / "model/.metadata").is_file():
+        raise ValueError(f"Checkpoint has no model DCP metadata: {checkpoint}")
+    maybe_init_distributed()
+    setup = OmniSetupOverrides(
+        checkpoint_path=str(checkpoint),
+        config_file=str(args.run_dir / "config.yaml"),
+        output_dir=args.run_dir / "inference_smoke",
+        sampler="unipc",
+        guardrails=False,
+        use_torch_compile=False,
+        experiment_overrides=["model.planning.initialize_from_base=false"],
+    ).build_setup()
+    init_output_dir(setup.output_dir)
+    setup = disable_runtime_ema_for_frozen_config(setup)
+    pipeline = OmniInference.create(setup)
+    model = pipeline.model
+    model.eval()
+    tokenizer_type = model.vlm_config.tokenizer.get("tokenizer_type")
+    if tokenizer_type is None or Path(tokenizer_type).resolve() != args.tokenizer.resolve():
+        raise ValueError("Requested tokenizer differs from the saved training tokenizer")
+    dataset = get_action_droid_sft_dataset(
+        root=str(args.data_root),
+        split="val",
+        episode_limit=128,
+        video_backend="pyav",
+        cfg_dropout_rate=0,
+        use_image_augmentation=False,
+        iterable_shuffle=False,
+        resolution="480",
+        format_prompt_as_json=True,
+        tokenizer_config=model.vlm_config.tokenizer,
+    )
+    sample = dataset[0]
+    batch = {}
+    for key, value in sample.items():
+        if key in IterativeJointDataLoader._MULTI_ITEM_KEYS:
+            batch[key] = [[value]]
+        elif isinstance(value, torch.Tensor):
+            batch[key] = [value.unsqueeze(0)]
+        else:
+            batch[key] = [value]
+    events = []
+    start = time.monotonic()
+    with torch.inference_mode():
+        output = model.generate_samples_from_batch(batch, seed=[42], evaluation_callback=events.append)
+    torch.cuda.synchronize()
+    action = output["action"][0].detach().float().cpu()
+    if action.shape != (33, 8) or not torch.isfinite(action).all():
+        raise ValueError(f"Invalid generated action shape/values: {action.shape}")
+    report = dict(
+        checkpoint=str(checkpoint),
+        split="val",
+        dataset_index=0,
+        seed=42,
+        action_shape=list(action.shape),
+        executed_prediction_shape=list(action[1:].shape),
+        finite=True,
+        elapsed_seconds=time.monotonic() - start,
+        sample_steps=len(events),
+        sampler_branch_evaluations=sum(batch[0].branch_evaluations for batch in events),
+        extra_prefill_evaluations=1,
+        timesteps=[batch[0].step.model_timestep for batch in events],
+        actions=action.tolist(),
+        scope="one offline validation window; no environment execution",
+    )
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({key: value for key, value in report.items() if key != "actions"}, indent=2))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    finally:
+        if torch.distributed.is_initialized():
+            torch.distributed.destroy_process_group()
